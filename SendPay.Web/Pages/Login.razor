@page "/login"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-auth-page">
    <MudPaper Class="sp-auth-card mud-elevation-3" Elevation="0">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:28px">
            <img src="/images/logo.png" alt="SendPay" class="sp-logo-img sp-logo-img--auth" />
            <LangSelector />
        </div>

        <MudText Typo="Typo.h5" Style="font-weight:800;color:var(--navy);margin-bottom:6px">@Lang.T("login_title")</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--text-sub);margin-bottom:24px">@Lang.T("login_subtitle")</MudText>

        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@error</MudAlert>
        }

        <MudTextField @bind-Value="email"
                      Label="@Lang.T("login_email")"
                      Placeholder="@Lang.T("login_email_ph")"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Email"
                      Class="mb-4"
                      FullWidth="true" />

        <MudTextField @bind-Value="password"
                      Label="@Lang.T("login_password")"
                      Placeholder="••••••••"
                      InputType="@(showPwd ? InputType.Text : InputType.Password)"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="() => showPwd = !showPwd"
                      Class="mb-5"
                      FullWidth="true" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   OnClick="HandleLogin"
                   Disabled="@loading"
                   Style="border-radius:10px;font-weight:700;height:50px;font-size:15px">
            @if (loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>@Lang.T("login_loading")</span>
            }
            else
            {
                <span>@Lang.T("login_btn")</span>
            }
        </MudButton>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.body2" Align="Align.Center" Style="color:var(--text-sub)">
            @Lang.T("login_switch")
            <MudLink Href="/register" Color="Color.Primary" Style="font-weight:600">@Lang.T("login_switch_link")</MudLink>
        </MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">
            <MudLink Href="/" Color="Color.Primary">@Lang.T("login_home")</MudLink>
        </MudText>
    </MudPaper>
</div>

@code {
    string email = "", password = "", error = "";
    bool loading, showPwd;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);
    }

    async Task HandleLogin()
    {
        error = "";
        loading = true;
        var (ok, data, err) = await Api.LoginAsync(email, password);
        loading = false;

        if (ok && data != null)
        {
            await LocalStorage.SetItemAsync("token", data.Token);
            await LocalStorage.SetItemAsync("fullName", data.FullName);
            await LocalStorage.SetItemAsync("isAdmin", data.IsAdmin);
            await LocalStorage.SetItemAsync("userId", data.UserId);
            Nav.NavigateTo(data.IsAdmin ? "/admin" : "/dashboard");
        }
        else error = err;
    }

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
