<!-- ===== MODAL: APP STORE (iOS) ===== -->
@if (showIosModal)
{
    <div class="sp-modal-backdrop" @onclick="() => showIosModal = false">
        <div class="sp-modal-box sp-modal-box-sm" @onclick:stopPropagation>
            <div class="sp-modal-header">
                <span><i class="fa-brands fa-apple" style="color:var(--navy);margin-right:8px"></i> App Store (iOS)</span>
                <button class="sp-modal-close" @onclick="() => showIosModal = false"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div style="text-align:center;padding:8px 0 16px">
                <div style="width:72px;height:72px;background:#f0f0f5;border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:36px;color:var(--navy)">
                    <i class="fa-brands fa-apple"></i>
                </div>
                <h3 style="font-size:18px;font-weight:800;color:var(--navy);margin-bottom:10px">SendPay cho iPhone / iPad</h3>
                <p style="font-size:14px;color:var(--text-sub);line-height:1.7;margin-bottom:20px">
                    Ứng dụng iOS đang được xây dựng.<br>Dự kiến ra mắt <strong>Q3 2026</strong>. Đăng ký để nhận thông báo sớm nhất.
                </p>
                <div style="display:flex;gap:8px">
                    <input type="email" placeholder="email@example.com"
                           class="sp-form-input" style="flex:1;padding:10px 14px"
                           @bind="notifEmail" />
                    <button class="sp-cta-full" style="width:auto;padding:10px 18px;white-space:nowrap"
                            @onclick="SubmitNotif" disabled="@notifSent">
                        @(notifSent ? "✓ Đã đăng ký" : "Nhận thông báo")
                    </button>
                </div>
                @if (notifSent)
                {
                    <p style="font-size:12px;color:var(--green);margin-top:8px">
                        <i class="fa-solid fa-circle-check"></i> Cảm ơn! Chúng tôi sẽ thông báo khi app ra mắt.
                    </p>
                }
            </div>
        </div>
    </div>
}

