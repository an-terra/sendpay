<!-- ===== MODAL: ĐIỀU KHOẢN ===== -->
@if (showTermsModal)
{
    <div class="sp-modal-backdrop" @onclick="() => showTermsModal = false">
        <div class="sp-modal-box" @onclick:stopPropagation style="max-width:600px;max-height:80vh;overflow-y:auto">
            <div class="sp-modal-header" style="position:sticky;top:0;background:white;padding-bottom:12px">
                <span><i class="fa-solid fa-file-contract" style="color:var(--red);margin-right:8px"></i> @Lang.T("footer_terms")</span>
                <button class="sp-modal-close" @onclick="() => showTermsModal = false"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div style="font-size:13px;color:var(--text-sub);line-height:1.8">
                @for (int i = 1; i <= 5; i++)
                {
                    var idx = i;
                    <div style="margin-bottom:16px">
                        <div style="font-weight:700;color:var(--navy);margin-bottom:4px">@Lang.T($"terms_{idx}_t")</div>
                        <p>@Lang.T($"terms_{idx}_b")</p>
                    </div>
                }
                <p style="font-size:11px;color:var(--text-muted);margin-top:16px;border-top:1px solid var(--gray-border);padding-top:12px">
                    @Lang.T("modal_updated"): 2026年1月1日
                </p>
            </div>
        </div>
    </div>
}

