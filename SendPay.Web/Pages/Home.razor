@page "/"
@inject NavigationManager Nav
@inject ILocalStorageService LocalStorage
@inject LanguageService Lang
@inject ApiService Api
@implements IDisposable

<!-- NAV -->
<nav class="sp-nav">
    <a class="sp-nav-logo" href="/">
        <img src="/images/logo.png" alt="SendPay" class="sp-logo-img sp-logo-img--light" />
    </a>
    <div class="sp-nav-links">
        <a href="#features">@Lang.T("nav_services")</a>
        <a href="#countries">@Lang.T("nav_countries")</a>
        <a href="#rates">@Lang.T("nav_rates")</a>
        <a href="#how">@Lang.T("nav_how")</a>
        <a href="#contact">@Lang.T("nav_contact")</a>
    </div>
    <div class="sp-nav-actions">
        <LangSelector />
        <a href="/login" class="btn-outline">@Lang.T("nav_login")</a>
        <a href="/register" class="btn-red">@Lang.T("nav_register")</a>
    </div>
</nav>

<!-- HERO -->
<section class="sp-hero">
    <div>
        <div class="sp-hero-badge"><i class="fa-solid fa-bolt"></i> @Lang.T("hero_badge")</div>
        <h1>@Lang.T("hero_title1")<br><span>@Lang.T("hero_accent")</span><br>@Lang.T("hero_title2")</h1>
        <p style="color:rgba(255,255,255,.8);font-size:16px;line-height:1.8;margin-bottom:24px">
            @Lang.T("hero_desc")
        </p>
        <div style="font-size:12px;color:rgba(255,255,255,.55);margin-bottom:18px">
            🇻🇳 Việt Nam &nbsp;·&nbsp; 🇱🇰 Sri Lanka &nbsp;·&nbsp; 🇳🇵 Nepal &nbsp;·&nbsp; 🇵🇭 Philippines
        </div>
        <div class="sp-hero-stats">
            <div class="sp-hero-stat"><div class="val">50K+</div><div class="lbl">@Lang.T("hero_stat1")</div></div>
            <div class="sp-hero-stat"><div class="val">4</div><div class="lbl">@Lang.T("hero_stat2")</div></div>
            <div class="sp-hero-stat"><div class="val">24/7</div><div class="lbl">@Lang.T("hero_stat3")</div></div>
        </div>
        <div class="sp-hero-btns">
            <a href="/register" class="btn-gold"><i class="fa-solid fa-paper-plane"></i> @Lang.T("hero_btn_send")</a>
            <a href="#how" class="btn-ghost"><i class="fa-solid fa-play"></i> @Lang.T("hero_btn_guide")</a>
        </div>
    </div>
    <div>
        <div class="sp-hero-card">
            <h3><i class="fa-solid fa-calculator" style="color:var(--red);margin-right:6px"></i> @Lang.T("calc_title")</h3>
            <div class="hero-field">
                <div class="hero-field-label">@Lang.T("calc_from")</div>
                <div class="hero-field-row">
                    <input class="hero-field-input" type="number" @bind="calcAmount" @bind:event="oninput" min="1000" />
                    <div class="hero-field-badge">
                        <img src="https://flagcdn.com/w40/jp.png" class="hero-flag-img" alt="JP" />
                        JPY
                    </div>
                </div>
            </div>
            <div class="hero-field">
                <div class="hero-field-label">@Lang.T("calc_dest")</div>
                <div class="hero-country-dropdown" @onclick:stopPropagation="true">
                    <div class="hero-country-selected" @onclick="() => countryDropdownOpen = !countryDropdownOpen">
                        <img src="https://flagcdn.com/w40/@(destCountry.ToLower()).png" class="hero-flag-img" alt="@destCountry" />
                        <span>@CountryName</span>
                        <i class="fa-solid fa-chevron-down" style="margin-left:auto;font-size:11px;color:var(--text-muted);transition:transform .2s;@(countryDropdownOpen ? "transform:rotate(180deg)" : "")"></i>
                    </div>
                    @if (countryDropdownOpen)
                    {
                        <div class="hero-country-list">
                            @foreach (var c in _countries)
                            {
                                <div class="hero-country-item @(destCountry == c.Code ? "active" : "")"
                                     @onclick="() => SelectCountry(c.Code)">
                                    <img src="https://flagcdn.com/w40/@(c.Code.ToLower()).png" class="hero-flag-img" alt="@c.Code" />
                                    <span>@c.Name</span>
                                    @if (destCountry == c.Code) { <i class="fa-solid fa-check" style="margin-left:auto;color:#3B5BDB;font-size:11px"></i> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="hero-field">
                <div class="hero-field-label">@Lang.T("calc_receive")</div>
                <div class="hero-field-row">
                    <span style="font-size:20px;font-weight:800;color:var(--navy)">@ReceivedAmount.ToString("N0")</span>
                    <div class="hero-field-badge">
                        <img src="https://flagcdn.com/w40/@(destCountry.ToLower()).png" class="hero-flag-img" alt="@destCountry" />
                        @CurrencyCode
                    </div>
                </div>
            </div>
            <div class="hero-rate-info">
                <span>@Lang.T("calc_fee"): <span style="color:var(--green);font-weight:600">¥@ServiceFee.ToString("N0")</span></span>
                <span class="fee-badge">@Lang.T("calc_instant")</span>
            </div>
            <div class="hero-rate-info" style="margin-top:6px;border-top:none;padding-top:0">
                <span style="font-size:12px;color:var(--text-muted)">@Lang.T("calc_rate"): 1 JPY = @Rate.ToString("N2") @CurrencyCode</span>
                <span style="font-size:12px;color:var(--text-muted)">SSL 256-bit</span>
            </div>
            <a href="/register" class="hero-cta">@Lang.T("calc_cta") <i class="fa-solid fa-arrow-right"></i></a>
            <p class="hero-disclaimer">@Lang.T("calc_note")</p>
        </div>
    </div>
</section>

<!-- COUNTRIES -->
<section class="sp-countries-section" id="countries">
    <div class="section-tag sp-tag-glass"><i class="fa-solid fa-earth-asia"></i> @Lang.T("sec_countries_tag")</div>
    <h2 class="section-title sp-title-light">@Lang.T("sec_countries_h2")</h2>
    <div class="sp-country-grid">
        <div class="sp-country-card sp-cc-vn">
            <div class="sp-country-flag-wrap">
                <img src="https://flagcdn.com/w80/vn.png" alt="VN" class="sp-country-flag-img" />
            </div>
            <div class="sp-country-code">VN</div>
            <h4>Việt Nam</h4>
            <div class="sp-country-rate">1 JPY ≈ <strong>@GetLiveRate("VND", 170)</strong> VND</div>
            <div class="sp-country-banks">Vietcombank · BIDV · Agribank · MB Bank</div>
            <span class="badge-fast"><i class="fa-solid fa-bolt"></i> @Lang.T("country_instant")</span>
        </div>
        <div class="sp-country-card sp-cc-lk">
            <div class="sp-country-flag-wrap">
                <img src="https://flagcdn.com/w80/lk.png" alt="LK" class="sp-country-flag-img" />
            </div>
            <div class="sp-country-code">LK</div>
            <h4>Sri Lanka</h4>
            <div class="sp-country-rate">1 JPY ≈ <strong>@GetLiveRate("LKR", 2.0m)</strong> LKR</div>
            <div class="sp-country-banks">Bank of Ceylon · Sampath · HNB · People's</div>
            <span class="badge-fast"><i class="fa-solid fa-bolt"></i> @Lang.T("country_instant")</span>
        </div>
        <div class="sp-country-card sp-cc-np">
            <div class="sp-country-flag-wrap">
                <img src="https://flagcdn.com/w80/np.png" alt="NP" class="sp-country-flag-img" />
            </div>
            <div class="sp-country-code">NP</div>
            <h4>Nepal</h4>
            <div class="sp-country-rate">1 JPY ≈ <strong>@GetLiveRate("NPR", 0.88m)</strong> NPR</div>
            <div class="sp-country-banks">Nepal Bank · NIC Asia · Himalayan · Global IME</div>
            <span class="badge-fast"><i class="fa-solid fa-bolt"></i> @Lang.T("country_instant")</span>
        </div>
        <div class="sp-country-card sp-cc-ph">
            <div class="sp-country-flag-wrap">
                <img src="https://flagcdn.com/w80/ph.png" alt="PH" class="sp-country-flag-img" />
            </div>
            <div class="sp-country-code">PH</div>
            <h4>Philippines</h4>
            <div class="sp-country-rate">1 JPY ≈ <strong>@GetLiveRate("PHP", 0.38m)</strong> PHP</div>
            <div class="sp-country-banks">BDO · BPI · Metrobank · UnionBank</div>
            <span class="badge-fast"><i class="fa-solid fa-bolt"></i> @Lang.T("country_instant")</span>
        </div>
    </div>
</section>

<!-- FEATURES -->
<section class="sp-feat-section" id="features">
    <div class="section-tag"><i class="fa-solid fa-star"></i> @Lang.T("sec_feat_tag")</div>
    <h2 class="section-title">@Lang.T("sec_feat_h2")</h2>
    <p class="section-sub">@Lang.T("sec_feat_sub")</p>
    <div class="sp-features-grid">
        <div class="feat-card">
            <div class="feat-icon feat-icon--red"><i class="fa-solid fa-bolt"></i></div>
            <h4>@Lang.T("feat1_title")</h4>
            <p>@Lang.T("feat1_desc")</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon feat-icon--blue"><i class="fa-solid fa-shield-halved"></i></div>
            <h4>@Lang.T("feat2_title")</h4>
            <p>@Lang.T("feat2_desc")</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon feat-icon--green"><i class="fa-solid fa-yen-sign"></i></div>
            <h4>@Lang.T("feat3_title")</h4>
            <p>@Lang.T("feat3_desc")</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon feat-icon--purple"><i class="fa-solid fa-id-card"></i></div>
            <h4>@Lang.T("feat4_title")</h4>
            <p>@Lang.T("feat4_desc")</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon feat-icon--teal"><i class="fa-solid fa-headset"></i></div>
            <h4>@Lang.T("feat5_title")</h4>
            <p>@Lang.T("feat5_desc")</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon feat-icon--gold"><i class="fa-solid fa-receipt"></i></div>
            <h4>@Lang.T("feat6_title")</h4>
            <p>@Lang.T("feat6_desc")</p>
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="sp-how" id="how">
    <div class="section-tag"><i class="fa-solid fa-list-check"></i> @Lang.T("sec_how_tag")</div>
    <h2 class="section-title">@Lang.T("sec_how_h2")</h2>
    <p class="section-sub">@Lang.T("sec_how_sub")</p>
    <div class="sp-steps">
        <div class="sp-step">
            <div class="sp-step-num">
                <span class="sp-step-badge">01</span>
                <i class="fa-solid fa-id-card"></i>
            </div>
            <div class="sp-step-body">
                <h4>@Lang.T("step1_title")</h4>
                <p>@Lang.T("step1_desc")</p>
            </div>
        </div>
        <div class="sp-step">
            <div class="sp-step-num">
                <span class="sp-step-badge">02</span>
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <div class="sp-step-body">
                <h4>@Lang.T("step2_title")</h4>
                <p>@Lang.T("step2_desc")</p>
            </div>
        </div>
        <div class="sp-step">
            <div class="sp-step-num">
                <span class="sp-step-badge">03</span>
                <i class="fa-solid fa-money-bill-wave"></i>
            </div>
            <div class="sp-step-body">
                <h4>@Lang.T("step3_title")</h4>
                <p>@Lang.T("step3_desc")</p>
            </div>
        </div>
        <div class="sp-step">
            <div class="sp-step-num sp-step-num--last">
                <span class="sp-step-badge sp-step-badge--gold">04</span>
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="sp-step-body">
                <h4>@Lang.T("step4_title")</h4>
                <p>@Lang.T("step4_desc")</p>
            </div>
        </div>
    </div>
</section>

<!-- RATES TABLE -->
<section class="sp-rates-section" id="rates">
    <div class="section-tag"><i class="fa-solid fa-table"></i> @Lang.T("sec_rates_tag")</div>
    <h2 class="section-title">@Lang.T("sec_rates_h2")</h2>
    <p class="section-sub">@Lang.T("sec_rates_sub")</p>
    <div class="sp-rate-table">
        <table>
            <thead>
                <tr>
                    <th>@Lang.T("rate_col1")</th>
                    <th>@Lang.T("rate_col2")</th>
                    <th>@Lang.T("rate_col3")</th>
                    <th>@Lang.T("rate_col4")</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="rt-amount">〜 ¥10,000</td>
                    <td><span class="rt-fee rt-fee--green">¥200</span></td>
                    <td><span class="badge-fast"><i class="fa-solid fa-bolt"></i> @Lang.T("rate_instant")</span></td>
                    <td class="rt-flags">
                        <img src="https://flagcdn.com/w40/vn.png" alt="VN" /><img src="https://flagcdn.com/w40/lk.png" alt="LK" /><img src="https://flagcdn.com/w40/np.png" alt="NP" /><img src="https://flagcdn.com/w40/ph.png" alt="PH" />
                    </td>
                </tr>
                <tr>
                    <td class="rt-amount">¥10,001 〜 ¥50,000</td>
                    <td><span class="rt-fee rt-fee--green">¥400</span></td>
                    <td><span class="badge-fast"><i class="fa-solid fa-bolt"></i> @Lang.T("rate_instant")</span></td>
                    <td class="rt-flags">
                        <img src="https://flagcdn.com/w40/vn.png" alt="VN" /><img src="https://flagcdn.com/w40/lk.png" alt="LK" /><img src="https://flagcdn.com/w40/np.png" alt="NP" /><img src="https://flagcdn.com/w40/ph.png" alt="PH" />
                    </td>
                </tr>
                <tr>
                    <td class="rt-amount">¥50,001 〜 ¥200,000</td>
                    <td><span class="rt-fee rt-fee--gold">¥800</span></td>
                    <td><span class="badge-std"><i class="fa-solid fa-clock"></i> @Lang.T("rate_sameday")</span></td>
                    <td class="rt-flags">
                        <img src="https://flagcdn.com/w40/vn.png" alt="VN" /><img src="https://flagcdn.com/w40/lk.png" alt="LK" /><img src="https://flagcdn.com/w40/np.png" alt="NP" /><img src="https://flagcdn.com/w40/ph.png" alt="PH" />
                    </td>
                </tr>
                <tr class="rt-vip-row">
                    <td class="rt-amount">¥200,001〜</td>
                    <td><span class="rt-fee rt-fee--gold">@Lang.T("rate_vip")</span></td>
                    <td><span class="badge-vip"><i class="fa-solid fa-headset"></i> @Lang.T("rate_contact")</span></td>
                    <td class="rt-flags">
                        <img src="https://flagcdn.com/w40/vn.png" alt="VN" /><img src="https://flagcdn.com/w40/lk.png" alt="LK" /><img src="https://flagcdn.com/w40/np.png" alt="NP" /><img src="https://flagcdn.com/w40/ph.png" alt="PH" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <p class="sp-rate-note">@Lang.T("rate_note")</p>
</section>

<!-- TESTIMONIALS -->
<section class="sp-testimonials">
    <div class="section-tag"><i class="fa-solid fa-heart"></i> @Lang.T("sec_test_tag")</div>
    <h2 class="section-title">@Lang.T("sec_test_h2")</h2>
    <div class="sp-test-grid">
        <div class="test-card">
            <div class="stars">★★★★★</div>
            <p>"Dùng SendPay được 1 năm rồi, chuyển tiền về Việt Nam rất nhanh, thường chỉ mất vài phút. Phí thấp hơn nhiều so với ngân hàng Nhật. Rất hài lòng!"</p>
            <div class="test-author">
                <div class="test-avatar" style="background:#D0001F">TN</div>
                <div>
                    <div class="test-name">Trần Nguyên</div>
                    <div class="test-loc">🇻🇳 Việt Nam · 東京都 在住</div>
                </div>
            </div>
        </div>
        <div class="test-card">
            <div class="stars">★★★★★</div>
