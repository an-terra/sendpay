                <div class="sp-flag-box"><img src="https://flagcdn.com/w40/vn.png" alt="VN" /></div>
                <div class="sp-flag-box"><img src="https://flagcdn.com/w40/lk.png" alt="LK" /></div>
                <div class="sp-flag-box"><img src="https://flagcdn.com/w40/np.png" alt="NP" /></div>
