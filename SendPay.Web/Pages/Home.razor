                </div>
            </div>
        </div>
        <div class="test-card">
            <div class="stars">★★★★★</div>
            <p>"Nepal maa paise pathauna SendPay sabai bhanda sajilo chha. Turant paisa pugcha, commission pani kam chha. Dherai ramro service!"</p>
            <div class="test-author">
                <div class="test-avatar" style="background:#C8971A">BS</div>
                <div>
                    <div class="test-name">Bikash Sharma</div>
                    <div class="test-loc">🇳🇵 Nepal · 愛知県 在住</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- APP PROMO -->
<section class="sp-app-promo">
    <div class="sp-app-promo-inner">
        <div>
            <h2>@Lang.T("promo_h2")</h2>
            <p>@Lang.T("promo_sub")</p>
            <div class="app-store-btns">
                <a class="app-store-btn" href="javascript:void(0)" @onclick="() => showIosModal = true">
                    <i class="fa-brands fa-apple"></i>
                    <div><div class="sub">@Lang.T("promo_dl")</div><div class="main">App Store</div></div>
                </a>
                <a class="app-store-btn" href="javascript:void(0)" @onclick="() => showAndroidModal = true">
                    <i class="fa-brands fa-google-play"></i>
                    <div><div class="sub">@Lang.T("promo_dl")</div><div class="main">Google Play</div></div>
                </a>
            </div>
        </div>
        <div class="app-mockup">
            <div class="app-mockup-inner">
                <div style="font-size:9px;opacity:.6">@Lang.T("dash_bal_label")</div>
                <div class="bal">¥125,000</div>
                <div style="font-size:9px;opacity:.6;margin-bottom:10px">ID: SP-038712</div>
                <div class="app-mockup-btns">
                    <div class="app-mockup-btn">@Lang.T("dash_topup")</div>
                    <div class="app-mockup-btn-red">@Lang.T("dash_transfer")</div>
                </div>
            </div>
        </div>
    </div>
</section>

