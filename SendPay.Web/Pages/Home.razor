<!-- ===== MODAL: CÔNG BỐ LUẬT THANH TOÁN ===== -->
@if (showDisclosureModal)
{
    <div class="sp-modal-backdrop" @onclick="() => showDisclosureModal = false">
        <div class="sp-modal-box" @onclick:stopPropagation style="max-width:600px;max-height:80vh;overflow-y:auto">
            <div class="sp-modal-header" style="position:sticky;top:0;background:white;padding-bottom:12px">
                <span><i class="fa-solid fa-scale-balanced" style="color:var(--red);margin-right:8px"></i> @Lang.T("footer_disclosure")</span>
                <button class="sp-modal-close" @onclick="() => showDisclosureModal = false"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div style="font-size:13px;color:var(--text-sub);line-height:1.8">
                <div style="background:#EFF6FF;border:1px solid #BFDBFE;border-radius:10px;padding:12px 16px;margin-bottom:16px;color:#1E40AF;font-size:12px">
                    <i class="fa-solid fa-circle-info" style="margin-right:6px"></i>
                    資金決済に関する法律（資金決済法）第37条に基づく表示 / Công bố theo Điều 37 Luật Thanh toán Nhật Bản
                </div>
                @foreach (var (label, value) in DisclosureValues)
                {
                    <div style="display:flex;padding:10px 0;border-bottom:1px solid var(--gray-border);gap:12px">
                        <div style="min-width:140px;font-weight:600;color:var(--navy);font-size:12px">@Lang.T(label)</div>
                        <div>@value</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    // ── Calculator ──────────────────────────────────────
    decimal calcAmount = 30_000;
    string destCountry = "VN";
    Dictionary<string, decimal> liveRates = new();

    // ── Modal state ──────────────────────────────────────
    bool showIosModal      = false;
    bool showAndroidModal  = false;
    bool showAboutModal    = false;
    bool showTermsModal    = false;
    bool showPrivacyModal  = false;
    bool showDisclosureModal = false;
    string notifEmail = "";
    bool notifSent    = false;

    void SubmitNotif()
    {
        if (!string.IsNullOrWhiteSpace(notifEmail))
            notifSent = true;
    }

    // disclosure: label = translation key, value = fixed regulatory data
    static readonly (string LabelKey, string Value)[] DisclosureValues =
    [
        ("disc_1_l",  "SendPay Japan 株式会社"),
        ("disc_2_l",  "関東財務局長（資移）第〇〇〇号"),
        ("disc_3_l",  "〒101-0047 東京都千代田区内神田1-1-1 SendPayビル5F"),
        ("disc_4_l",  "第二種資金移動業（送金上限 100万円）"),
        ("disc_5_l",  "JPY → VND, LKR, NPR, PHP"),
        ("disc_6_l",  "1回 ¥200,000 / 年間 ¥1,000,000"),
        ("disc_7_l",  "¥200〜¥800"),
        ("disc_8_l",  "即時〜翌営業日"),
        ("disc_9_l",  "support@sendpay.jp / 03-0000-0000"),
        ("disc_10_l", "法務局指定供託所に全額供託済み"),
    ];

    string CurrencyCode => destCountry switch {
        "VN" => "VND", "LK" => "LKR", "NP" => "NPR", "PH" => "PHP", _ => "VND"
    };
    string CurrencyLabel => destCountry switch {
        "VN" => "🇻🇳 VND", "LK" => "🇱🇰 LKR", "NP" => "🇳🇵 NPR", "PH" => "🇵🇭 PHP", _ => "🇻🇳 VND"
    };

    decimal Rate => liveRates.TryGetValue(CurrencyCode, out var r) ? r : destCountry switch {
        "VN" => 170m, "LK" => 2.0m, "NP" => 0.88m, "PH" => 0.38m, _ => 170m
    };

    decimal ServiceFee => calcAmount <= 10_000 ? 200 : calcAmount <= 50_000 ? 400 : 800;
    decimal ReceivedAmount => (calcAmount - ServiceFee) * Rate;

    string GetLiveRate(string code, decimal fallback)
    {
        var val = liveRates.TryGetValue(code, out var r) ? r : fallback;
        return val >= 10 ? val.ToString("N0") : val.ToString("N2").TrimEnd('0').TrimEnd('.');
    }

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);

        try
        {
            var resp = await Api.GetRatesAsync();
            if (resp != null)
                foreach (var r in resp.Rates)
                    liveRates[r.Code] = r.Rate;
        }
        catch { }
    }

    void OnCountryChange(ChangeEventArgs e)
    {
        destCountry = e.Value?.ToString() ?? "VN";
    }

    bool countryDropdownOpen = false;

    record CountryOption(string Code, string Name);
    static readonly CountryOption[] _countries = [
        new("VN", "Việt Nam"),
        new("LK", "Sri Lanka"),
        new("NP", "Nepal"),
        new("PH", "Philippines"),
    ];
    string CountryName => _countries.First(c => c.Code == destCountry).Name;
    void SelectCountry(string code) { destCountry = code; countryDropdownOpen = false; }

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
