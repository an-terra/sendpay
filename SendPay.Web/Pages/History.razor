@page "/history"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-dash-page">
    <DashNav Active="history" />
    <div class="sp-dash-content">

        <div class="sp-page-header">
            <a href="/dashboard" class="sp-back-circle"><i class="fa-solid fa-arrow-left"></i></a>
            <div><h1 class="sp-page-title">@Lang.T("hist_title")</h1></div>
        </div>

        @if (loading)
        {
            <div class="sp-dash-tx-card" style="text-align:center;padding:48px">
                <i class="fa-solid fa-spinner fa-spin" style="font-size:28px;color:var(--red)"></i>
                <div style="color:var(--text-muted);font-size:13px;margin-top:12px">@Lang.T("hist_loading")</div>
            </div>
        }
        else if (transactions.Count == 0)
        {
            <div class="sp-dash-tx-card" style="text-align:center;padding:64px 48px">
                <i class="fa-solid fa-inbox" style="font-size:40px;color:var(--gray-border);display:block;margin-bottom:14px"></i>
                <div style="color:var(--text-muted);font-size:15px">@Lang.T("hist_empty")</div>
            </div>
        }
        else
        {
            <div class="sp-dash-tx-card">
                @foreach (var (tx, idx) in transactions.Select((t, i) => (t, i)))
                {
                    bool isIncoming = tx.Type == 1 || (tx.Type == 0 && tx.SenderId != currentUserId);
                    string label = tx.Type == 1
                        ? Lang.T("hist_topup")
                        : isIncoming ? $"{tx.SenderName} → {Lang.T("hist_you")}" : $"{Lang.T("hist_you")} → {tx.ReceiverName}";
                    var bankLine = tx.Type == 0 ? FormatBankLine(tx.ReceiverBankName, tx.ReceiverAccountNumber) : "";
                    string avatarBg = tx.Type == 1 ? "linear-gradient(140deg,#38d9a9,#0C8599)"
                                    : isIncoming  ? "linear-gradient(140deg,#51cf66,#0D7A4E)"
                                    : "linear-gradient(140deg,#ff8fa3,#D0001F)";
                    string txIcon = tx.Type == 1 ? "fa-solid fa-plus" : "fa-solid fa-paper-plane";

                    <div class="sp-dash-tx-row">
                        <div class="sp-tx-avatar" style="background:@avatarBg;flex-shrink:0">
                            <i class="@txIcon" style="font-size:16px"></i>
                        </div>
                        <div style="flex:1;min-width:0">
                            <div style="font-weight:600;color:var(--navy);font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@label</div>
                            @if (!string.IsNullOrEmpty(tx.Note) && tx.Type != 1)
                            {
                                <div style="color:var(--text-sub);font-size:12px;font-style:italic;margin-top:2px">@tx.Note</div>
                            }
                            @if (!string.IsNullOrEmpty(bankLine))
                            {
                                <div style="color:var(--text-sub);font-size:11px;margin-top:2px">@Lang.T("tr_bank_lbl") · @bankLine</div>
                            }
                            <div style="color:var(--text-muted);font-size:12px;margin-top:2px">@tx.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                        </div>
                        <div style="text-align:right;flex-shrink:0">
                            <div style="font-weight:700;font-size:15px;@(isIncoming ? "color:#0D7A4E" : "color:var(--red)")">
                                @(isIncoming ? "+" : "−")¥@tx.Amount.ToString("N0")
                            </div>
                            @if (!isIncoming && tx.Fee > 0)
                            {
                                <div style="font-size:11px;color:var(--text-muted);margin-top:2px">@Lang.T("tr_fee_lbl"): ¥@tx.Fee.ToString("N0")</div>
                            }
                            <div class="sp-tx-status" style="margin-top:4px">@Lang.T("hist_success")</div>
                        </div>
                    </div>
                }
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem">
                <button class="sp-btn-gray" style="flex:unset;padding:10px 20px" @onclick="PrevPage" disabled="@(page <= 1)">
                    <i class="fa-solid fa-chevron-left"></i> @Lang.T("hist_prev")
                </button>
                <span style="font-size:13px;font-weight:600;color:var(--navy);background:var(--gray-bg);border-radius:20px;padding:6px 18px;border:1px solid var(--gray-border)">
                    @Lang.T("hist_page") @(page)
                </span>
                <button class="sp-btn-gray" style="flex:unset;padding:10px 20px" @onclick="NextPage" disabled="@(transactions.Count < 10)">
                    @Lang.T("hist_next") <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        }

    </div>
</div>

@code {
    List<TransactionResponse> transactions = [];
    bool loading = true;
    int page = 1;
    int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var token = await LocalStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token)) { Nav.NavigateTo("/login"); return; }
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);
        currentUserId = await LocalStorage.GetItemAsync<int>("userId");
        await LoadPage();
    }

    async Task LoadPage()
    {
        loading = true;
        transactions = await Api.GetHistoryAsync(page) ?? [];
        loading = false;
    }

    async Task PrevPage() { if (page > 1) { page--; await LoadPage(); } }
    async Task NextPage() { page++; await LoadPage(); }

    static string AccountKey(string? s) =>
        string.IsNullOrEmpty(s) ? "" : string.Concat(s.Where(char.IsLetterOrDigit)).ToUpperInvariant();

    static string FormatBankLine(string? bankName, string? accountNumber)
    {
        if (string.IsNullOrWhiteSpace(bankName) && string.IsNullOrWhiteSpace(accountNumber)) return "";
        var bn = string.IsNullOrWhiteSpace(bankName) ? "—" : bankName.Trim();
        var key = AccountKey(accountNumber);
        var tail = string.IsNullOrEmpty(key) ? "" : (key.Length <= 4 ? key : key[^4..]);
        return string.IsNullOrEmpty(tail) ? bn : $"{bn} · ****{tail}";
    }

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
