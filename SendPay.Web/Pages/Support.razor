@page "/support"
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-dash-page">
    <DashNav Active="support" />
    <div class="sp-dash-content">

        <div class="sp-page-header">
            <a href="/dashboard" class="sp-back-circle"><i class="fa-solid fa-arrow-left"></i></a>
            <div class="sp-page-icon qi-pink"><i class="fa-solid fa-headset"></i></div>
            <div>
                <div class="sp-page-title">@Lang.T("support_title")</div>
                <div class="sp-page-sub">@Lang.T("support_sub")</div>
            </div>
        </div>

        <div class="sp-support-grid">

            <!-- LEFT: FAQ -->
            <div>
                <MudPaper Class="mud-elevation-1" Style="border-radius:16px;overflow:hidden">
                    <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--gray-border);display:flex;align-items:center;gap:8px">
                        <MudIcon Icon="@Icons.Material.Filled.QuestionAnswer" Style="color:#e64980" />
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:var(--navy)">@Lang.T("support_faq")</MudText>
                    </div>
                    <MudExpansionPanels Elevation="0">
                        @foreach (var (faq, i) in faqs.Select((f, i) => (f, i)))
                        {
                            <MudExpansionPanel Text="@Lang.T(faq.Q)"
                                               Style="border-bottom:1px solid var(--gray-border)">
                                <MudText Typo="Typo.body2" Style="color:var(--text-sub);line-height:1.7;padding:4px 0">
                                    @Lang.T(faq.A)
                                </MudText>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                </MudPaper>
            </div>

            <!-- RIGHT: Contact + Security -->
            <div>
                <MudPaper Class="sp-side-card mud-elevation-1" Style="border-radius:16px;padding:24px">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:var(--navy);margin-bottom:1.2rem;display:flex;align-items:center;gap:8px">
                        <MudIcon Icon="@Icons.Material.Filled.Phone" Style="color:#e64980" />
                        @Lang.T("support_contact_title")
                    </MudText>

                    <div class="sp-contact-list">
                        <div class="sp-contact-item">
                            <div class="sp-contact-icon" style="background:#fff0f5;color:#e64980">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <div>
                                <MudText Typo="Typo.caption" Style="color:var(--text-muted);font-weight:600">@Lang.T("support_email")</MudText>
                                <MudLink Href="mailto:support@sendpay.jp" Style="color:var(--navy);font-weight:600;font-size:14px">
                                    support@sendpay.jp
                                </MudLink>
                            </div>
                        </div>
                        <div class="sp-contact-item">
                            <div class="sp-contact-icon" style="background:#e8f5e9;color:#388e3c">
                                <i class="fa-brands fa-line"></i>
                            </div>
                            <div>
                                <MudText Typo="Typo.caption" Style="color:var(--text-muted);font-weight:600">LINE</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:600;color:var(--navy)">&#64;sendpay_official</MudText>
                            </div>
                        </div>
                        <div class="sp-contact-item">
                            <div class="sp-contact-icon" style="background:#e3f2fd;color:#1976d2">
                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Style="font-size:18px" />
                            </div>
                            <div>
                                <MudText Typo="Typo.caption" Style="color:var(--text-muted);font-weight:600">@Lang.T("support_hours")</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:600;color:var(--navy)">9:00 – 18:00 JST (Mon–Sat)</MudText>
                            </div>
                        </div>
                    </div>
                </MudPaper>

                <MudPaper Class="sp-side-card mud-elevation-2 mt-3"
                          Style="border-radius:16px;padding:20px;background:linear-gradient(135deg,#0B1E3D,#1a3260)">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700;color:white;margin-bottom:8px;display:flex;align-items:center;gap:8px">
                        <MudIcon Icon="@Icons.Material.Filled.Security" Style="color:#FFD166" />
                        @Lang.T("support_security_title")
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,.8);line-height:1.7">
                        @Lang.T("support_security_body")
                    </MudText>
                </MudPaper>
            </div>

        </div>
    </div>
</div>

@code {
    record Faq(string Q, string A);
    readonly List<Faq> faqs =
    [
        new("faq_q1", "faq_a1"),
        new("faq_q2", "faq_a2"),
        new("faq_q3", "faq_a3"),
        new("faq_q4", "faq_a4"),
        new("faq_q5", "faq_a5"),
    ];

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var token = await LocalStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token)) { Nav.NavigateTo("/login"); return; }
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);
    }

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
