@page "/receipt"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-dash-page">
    <DashNav Active="receipt" />
    <div class="sp-dash-content">

        <div class="sp-page-header">
            <a href="/dashboard" class="sp-back-circle"><i class="fa-solid fa-arrow-left"></i></a>
            <div class="sp-page-icon qi-green"><i class="fa-solid fa-receipt"></i></div>
            <div>
                <div class="sp-page-title">@Lang.T("receipt_title")</div>
                <div class="sp-page-sub">@Lang.T("receipt_sub")</div>
            </div>
        </div>

        @if (loading)
        {
            <MudPaper Class="mud-elevation-1 pa-8" Style="border-radius:16px;text-align:center">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            </MudPaper>
        }
        else if (transactions.Count == 0)
        {
            <MudPaper Class="mud-elevation-1 pa-8" Style="border-radius:16px;text-align:center">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size:48px;color:var(--gray-border)" />
                <MudText Typo="Typo.body1" Style="color:var(--text-muted);margin-top:12px">@Lang.T("dash_empty")</MudText>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="mud-elevation-1" Style="border-radius:16px;overflow:hidden">
                <MudList T="TransactionResponse" Padding="false">
                    @foreach (var (tx, idx) in transactions.Select((t, i) => (t, i)))
                    {
                        bool isTopUp = tx.Type == 1;
                        string initials = isTopUp ? "+" : GetInitials(tx.ReceiverName);
                        string avatarBg = isTopUp ? "#0D7A4E" : "#3B5BDB";

                        <MudListItem T="TransactionResponse"
                                     OnClick="() => OpenReceipt(tx)"
                                     Style="@($"padding:14px 20px;cursor:pointer;{(idx < transactions.Count - 1 ? "border-bottom:1px solid var(--gray-border)" : "")}")">
                            <div style="display:flex;align-items:center;gap:14px">
                                <MudAvatar Style="@($"background:{avatarBg};color:white;font-weight:700;font-size:12px;flex-shrink:0")">
                                    @initials
                                </MudAvatar>
                                <div style="flex:1;min-width:0">
                                    <MudText Typo="Typo.body2" Style="font-weight:600;color:var(--navy)">
                                        @(isTopUp ? Lang.T("dash_topup_lbl") : tx.ReceiverName)
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="color:var(--text-muted)">
                                        @tx.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ·
                                        @(isTopUp ? Lang.T("dash_topup_lbl") : Lang.T("dash_transfer_lbl"))
                                    </MudText>
                                    @if (!isTopUp && (!string.IsNullOrWhiteSpace(tx.ReceiverBankName) || !string.IsNullOrWhiteSpace(tx.ReceiverAccountNumber)))
                                    {
                                        <MudText Typo="Typo.caption" Style="color:var(--text-sub);font-size:11px;margin-top:2px">
                                            @Lang.T("tr_bank_lbl") · @FormatReceiptBank(tx.ReceiverBankName, tx.ReceiverAccountNumber)
                                        </MudText>
                                    }
                                </div>
                                <div style="text-align:right;flex-shrink:0">
                                    <MudText Typo="Typo.body2" Style="@($"font-weight:700;{(isTopUp ? "color:#0D7A4E" : "color:var(--red)")}")">
                                        @(isTopUp ? "+" : "−")¥@tx.Amount.ToString("N0")
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Style="height:18px;font-size:10px">
                                        ✓ @Lang.T("dash_done")
                                    </MudChip>
                                </div>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Style="color:var(--text-muted);font-size:16px;flex-shrink:0" />
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem">
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ChevronLeft"
                           OnClick="PrevPage" Disabled="@(currentPage <= 1)"
                           Style="border-radius:10px">
                    @Lang.T("hist_prev")
                </MudButton>
                <MudChip T="string" Color="Color.Default" Style="font-weight:600">
                    @Lang.T("hist_page") @currentPage
                </MudChip>
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           EndIcon="@Icons.Material.Filled.ChevronRight"
                           OnClick="NextPage" Disabled="@(transactions.Count < 10)"
                           Style="border-radius:10px">
                    @Lang.T("hist_next")
                </MudButton>
            </div>
        }

    </div>
</div>

<!-- Receipt Detail Dialog -->
@if (selected != null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1200" OnClick="CloseReceipt" />
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:1300;width:min(480px,94vw)">
        <MudPaper Class="mud-elevation-24" Style="border-radius:20px;overflow:hidden">
            <!-- Header -->
            <div style="background:linear-gradient(135deg,var(--navy),#1a3260);padding:24px;text-align:center">
                <img src="/images/logo.png" alt="SendPay" class="sp-logo-img sp-logo-img--modal" style="display:block;margin:0 auto 10px" />
                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.6)">@Lang.T("receipt_modal_title")</MudText>
            </div>
            <!-- Amount -->
            <div style="text-align:center;padding:20px 24px;border-bottom:1px solid var(--gray-border)">
                <MudText Typo="Typo.h4" Style="@($"font-weight:800;{(selected.Type == 1 ? "color:#0D7A4E" : "color:var(--red)") }")">
                    @(selected.Type == 1 ? "+" : "−")¥@selected.Amount.ToString("N0")
                </MudText>
            </div>
            <!-- Details -->
            <div style="padding:16px 24px">
                <div class="sp-receipt-row"><span>@Lang.T("receipt_id")</span><strong>#@selected.Id</strong></div>
                <div class="sp-receipt-row"><span>@Lang.T("receipt_from")</span><strong>@selected.SenderName</strong></div>
                <div class="sp-receipt-row"><span>@Lang.T("receipt_to")</span><strong>@selected.ReceiverName</strong></div>
                @if (!string.IsNullOrEmpty(selected.Note))
                {
                    <div class="sp-receipt-row"><span>@Lang.T("receipt_note")</span><strong>@selected.Note</strong></div>
                }
                @if (selected.Type != 1 && (!string.IsNullOrWhiteSpace(selected.ReceiverBankName) || !string.IsNullOrWhiteSpace(selected.ReceiverAccountNumber)))
                {
                    <div class="sp-receipt-row"><span>@Lang.T("tr_bank_lbl") / @Lang.T("tr_account_lbl")</span><strong>@FormatReceiptBank(selected.ReceiverBankName, selected.ReceiverAccountNumber)</strong></div>
                }
                <div class="sp-receipt-row"><span>@Lang.T("receipt_date")</span><strong>@selected.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</strong></div>
                <div class="sp-receipt-row"><span>@Lang.T("receipt_status")</span><strong style="color:var(--green)">✓ @Lang.T("dash_done")</strong></div>
            </div>
            <!-- Actions -->
            <div style="padding:0 24px 20px;display:flex;gap:10px">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="CloseReceipt" Style="border-radius:10px;font-weight:700">
                    @Lang.T("receipt_close")
                </MudButton>
            </div>
        </MudPaper>
    </div>
}

@code {
    List<TransactionResponse> transactions = [];
    TransactionResponse? selected;
    bool loading = true;
    int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var token = await LocalStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token)) { Nav.NavigateTo("/login"); return; }
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);
        await LoadPage();
    }

    async Task LoadPage()
    {
        loading = true;
        transactions = await Api.GetHistoryAsync(currentPage);
        loading = false;
    }

    async Task PrevPage() { if (currentPage > 1) { currentPage--; await LoadPage(); } }
    async Task NextPage() { currentPage++; await LoadPage(); }

    void OpenReceipt(TransactionResponse tx) => selected = tx;
    void CloseReceipt() => selected = null;

    static string AccountKey(string? s) =>
        string.IsNullOrEmpty(s) ? "" : string.Concat(s.Where(char.IsLetterOrDigit)).ToUpperInvariant();

    static string FormatReceiptBank(string? bankName, string? accountNumber)
    {
        var bn = string.IsNullOrWhiteSpace(bankName) ? "—" : bankName.Trim();
        var key = AccountKey(accountNumber);
        var tail = string.IsNullOrEmpty(key) ? "—" : (key.Length <= 4 ? key : key[^4..]);
        return $"{bn} · ****{tail}";
    }

    static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}".ToUpper() : name[..Math.Min(2, name.Length)].ToUpper();
    }

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
