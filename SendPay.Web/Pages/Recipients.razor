@page "/recipients"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-dash-page">
    <DashNav Active="recipients" />
    <div class="sp-dash-content">

        <div class="sp-page-header">
            <a href="/dashboard" class="sp-back-circle"><i class="fa-solid fa-arrow-left"></i></a>
            <div class="sp-page-icon qi-purple"><i class="fa-solid fa-users"></i></div>
            <div>
                <div class="sp-page-title">@Lang.T("recip_title")</div>
                <div class="sp-page-sub">@Lang.T("recip_sub")</div>
            </div>
        </div>

        <div class="sp-recip-grid">

            <div>
                @if (loading)
                {
                    <MudPaper Class="mud-elevation-1 pa-6" Style="border-radius:16px;text-align:center">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                    </MudPaper>
                }
                else if (recipients.Count == 0)
                {
                    <MudPaper Class="mud-elevation-1 pa-8" Style="border-radius:16px;text-align:center">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Style="font-size:42px;color:var(--gray-border)" />
                        <MudText Typo="Typo.body1" Style="color:var(--text-muted);margin-top:12px">@Lang.T("recip_empty")</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="mud-elevation-1" Style="border-radius:16px;overflow:hidden">
                        <MudList T="RecipientResponse" Padding="false">
                            @foreach (var (r, idx) in recipients.Select((x, i) => (x, i)))
                            {
                                <MudListItem T="RecipientResponse" Style="@($"padding:14px 20px;{(idx < recipients.Count - 1 ? "border-bottom:1px solid var(--gray-border)" : "")}")">
                                    <div style="display:flex;align-items:flex-start;gap:14px">
                                        <MudAvatar Style="background:#7048e8;color:white;font-weight:700;flex-shrink:0">
                                            @GetInitials(r.Name)
                                        </MudAvatar>
                                        <div style="flex:1;min-width:0">
                                            <MudText Typo="Typo.body2" Style="font-weight:600;color:var(--navy)">@r.Name</MudText>
                                            <MudText Typo="Typo.caption" Style="color:var(--text-sub);line-height:1.4">
                                                @if (!string.IsNullOrEmpty(r.Phone))
                                                {
                                                    <span><MudIcon Icon="@Icons.Material.Filled.Phone" Style="font-size:11px;vertical-align:middle" /> @r.Phone</span>
                                                }
                                                else
                                                {
                                                    <span style="color:var(--text-muted)">—</span>
                                                }
                                                @if (!string.IsNullOrEmpty(r.BankName) || !string.IsNullOrEmpty(r.AccountNumber))
                                                {
                                                    <span> · @(string.IsNullOrEmpty(r.BankName) ? "" : r.BankName + " ")</span>
                                                    @if (!string.IsNullOrEmpty(r.AccountNumber))
                                                    {
                                                        <span>****@Last4Digits(r.AccountNumber)</span>
                                                    }
                                                }
                                                @if (!string.IsNullOrEmpty(r.Note)) { <span> · @r.Note</span> }
                                            </MudText>
                                        </div>
                                        <div style="display:flex;flex-wrap:wrap;gap:6px;flex-shrink:0;justify-content:flex-end">
                                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                                       OnClick="@(async _ => await StartEdit(r))" Style="border-radius:8px;font-size:11px">
                                                @Lang.T("recip_edit")
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                       Href="@($"/transfer?recipientId={r.Id}")"
                                                       StartIcon="@Icons.Material.Filled.Send"
                                                       Style="border-radius:8px;font-size:11px">
                                                @Lang.T("recip_send")
                                            </MudButton>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                           Variant="Variant.Outlined" Style="border-radius:8px"
                                                           OnClick="() => DeleteRecipient(r.Id)" />
                                        </div>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                }
            </div>

            <MudPaper Class="sp-side-card mud-elevation-1" Style="border-radius:16px;padding:24px">
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:var(--navy);margin-bottom:1rem;display:flex;align-items:center;gap:8px">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Style="color:#7048e8" />
                    @(editingId.HasValue ? Lang.T("recip_edit") : Lang.T("recip_add_title"))
                </MudText>

                @if (!string.IsNullOrEmpty(addError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@addError</MudAlert>
                }
                @if (!string.IsNullOrEmpty(addSuccess))
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@addSuccess</MudAlert>
                }

                <MudTextField @bind-Value="newName"
                              Label="@Lang.T("recip_name")"
                              Placeholder="Nguyen Van A"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              FullWidth="true"
                              Class="mb-3" />

                <MudTextField @bind-Value="newPhone"
                              Label="@Lang.T("recip_phone")"
                              Placeholder="@Lang.T("recip_phone_ph")"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Phone"
                              FullWidth="true"
                              Class="mb-3" />

                <MudText Typo="Typo.caption" Style="font-weight:600;color:var(--text-muted);margin-bottom:4px">@Lang.T("recip_country")</MudText>
                <MudSelect T="string" @bind-Value="newCountry" @bind-Value:after="OnNewCountryChanged" Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("VN")">@Lang.T("recip_country_vn")</MudSelectItem>
                    <MudSelectItem Value="@("LK")">@Lang.T("recip_country_lk")</MudSelectItem>
                    <MudSelectItem Value="@("NP")">@Lang.T("recip_country_np")</MudSelectItem>
                    <MudSelectItem Value="@("PH")">@Lang.T("recip_country_ph")</MudSelectItem>
                    <MudSelectItem Value="@("OTHER")">@Lang.T("recip_country_other")</MudSelectItem>
                </MudSelect>

                @if (RecipientCatalogCountries.UsesCatalog(newCountry))
                {
                    <MudTextField @bind-Value="newBankFilter"
                                  Immediate="true"
                                  Label="@Lang.T("recip_bank_search")"
                                  Placeholder="@Lang.T("recip_bank_ph")"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  FullWidth="true"
                                  Class="mb-2" />
                    @if (FilteredCatalogBanks.Count > 0 && (string.IsNullOrEmpty(newBank) || !string.Equals(newBankFilter, newBank, StringComparison.Ordinal)))
                    {
                        <div style="max-height:180px;overflow-y:auto;border:1px solid var(--gray-border);border-radius:10px;margin-bottom:12px">
                            @foreach (var b in FilteredCatalogBanks.Take(25))
                            {
                                <div style="padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--gray-border);font-size:13px"
                                     @onclick="@(() => SelectCatalogBank(b))" @onclick:stopPropagation="true">
                                    @b.Name
                                </div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(newBank))
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3" Style="font-size:12px">@Lang.T("recip_bank_picked"): @newBank</MudAlert>
                    }
                }
                else
                {
                    <MudTextField @bind-Value="newBank"
                                  Label="@Lang.T("recip_bank")"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.AccountBalance"
                                  FullWidth="true"
                                  Class="mb-3" />
                }

                <MudTextField @bind-Value="newAccount"
                              Label="@Lang.T("recip_account")"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Class="mb-3" />

                <MudTextField @bind-Value="newHolder"
                              Label="@Lang.T("recip_holder")"
                              Placeholder="@Lang.T("recip_holder_ph")"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Class="mb-3" />

                <MudTextField @bind-Value="newNote"
                              Label="@Lang.T("recip_note")"
                              Placeholder="@Lang.T("recip_note_ph")"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Notes"
                              FullWidth="true"
                              Class="mb-4" />

                <MudStack Row="true" Spacing="2">
                    @if (editingId.HasValue)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                                   OnClick="CancelEdit">@Lang.T("recip_cancel")</MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth="true" Size="Size.Large"
                               OnClick="SaveRecipient" Disabled="@adding"
                               StartIcon="@Icons.Material.Filled.Save"
                               Style="border-radius:10px;font-weight:700;height:48px">
                        @if (adding)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        @(editingId.HasValue ? Lang.T("recip_save") : Lang.T("recip_add_btn"))
                    </MudButton>
                </MudStack>
            </MudPaper>
        </div>
    </div>
</div>

@code {
    List<RecipientResponse> recipients = [];
    readonly Dictionary<string, List<CatalogBankOption>> _catalogBankCache = new(StringComparer.OrdinalIgnoreCase);
    List<CatalogBankOption> catalogBanks = [];
    bool loading = true;
    bool adding;
    int? editingId;
    string newName = "", newPhone = "", newNote = "", newCountry = "VN", newBank = "", newBankFilter = "";
    string newAccount = "", newHolder = "";
    string addError = "", addSuccess = "";

    List<CatalogBankOption> FilteredCatalogBanks
    {
        get
        {
            if (catalogBanks.Count == 0) return [];
            var q = (newBankFilter ?? "").Trim();
            if (string.IsNullOrEmpty(q)) return catalogBanks;
            return [.. catalogBanks.Where(b => b.Name.Contains(q, StringComparison.OrdinalIgnoreCase))];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var token = await LocalStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token)) { Nav.NavigateTo("/login"); return; }
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);
        await EnsureCatalogLoadedAsync(newCountry);
        await Reload();
    }

    async Task OnNewCountryChanged()
    {
        addError = "";
        newBank = "";
        newBankFilter = "";
        await EnsureCatalogLoadedAsync(newCountry);
        await InvokeAsync(StateHasChanged);
    }

    async Task EnsureCatalogLoadedAsync(string country)
    {
        if (!RecipientCatalogCountries.UsesCatalog(country))
        {
            catalogBanks = [];
            return;
        }

        if (_catalogBankCache.TryGetValue(country, out var hit))
        {
            catalogBanks = hit;
            return;
        }

        try
        {
            var list = await Api.GetCatalogBanksAsync(country);
            _catalogBankCache[country] = list;
            catalogBanks = list;
        }
        catch
        {
            catalogBanks = [];
        }
    }

    void SelectCatalogBank(CatalogBankOption b)
    {
        newBank = b.Name;
        newBankFilter = b.Name;
        addError = "";
    }

    async Task Reload()
    {
        loading = true;
        recipients = await Api.GetRecipientsAsync();
        loading = false;
    }

    async Task StartEdit(RecipientResponse r)
    {
        addError = addSuccess = "";
        editingId = r.Id;
        newName = r.Name;
        newPhone = r.Phone ?? "";
        newNote = r.Note;
        newCountry = RecipientCatalogCountries.FormCountryFromRecipient(r);
        newBank = r.BankName ?? "";
        newBankFilter = RecipientCatalogCountries.UsesCatalog(newCountry) ? newBank : "";
        newAccount = r.AccountNumber ?? "";
        newHolder = r.AccountHolderName ?? "";
        await EnsureCatalogLoadedAsync(newCountry);
    }

    void CancelEdit()
    {
        editingId = null;
        _ = ClearFormFieldsAsync();
        addError = addSuccess = "";
    }

    async Task ClearFormFieldsAsync()
    {
        newName = newPhone = newNote = newBank = newBankFilter = newAccount = newHolder = "";
        newCountry = "VN";
        await EnsureCatalogLoadedAsync("VN");
    }

    async Task SaveRecipient()
    {
        addError = ""; addSuccess = "";
        if (string.IsNullOrWhiteSpace(newName))
        { addError = Lang.T("recip_err_required"); return; }

        var ph = string.IsNullOrWhiteSpace(newPhone) ? null : newPhone.Trim();
        var bk = string.IsNullOrWhiteSpace(newBank) ? null : newBank.Trim();
        var ac = string.IsNullOrWhiteSpace(newAccount) ? null : newAccount.Trim();
        var ho = string.IsNullOrWhiteSpace(newHolder) ? null : newHolder.Trim();

        if (string.IsNullOrEmpty(bk) || string.IsNullOrEmpty(ac) || string.IsNullOrEmpty(ho))
        { addError = Lang.T("recip_err_bank_full"); return; }

        if (RecipientCatalogCountries.UsesCatalog(newCountry))
        {
            var match = catalogBanks.Any(b => string.Equals(b.Name, bk, StringComparison.OrdinalIgnoreCase));
            if (!match)
            { addError = Lang.T("recip_err_bank_catalog"); return; }
        }

        if (AccountKey(ac).Length < 6)
        { addError = Lang.T("recip_err_account"); return; }

        adding = true;
        (bool ok, _, string err) = editingId is int eid
            ? await Api.UpdateRecipientAsync(eid, newName.Trim(), ph, newNote.Trim(), newCountry, bk, ac, ho)
            : await Api.AddRecipientAsync(newName.Trim(), ph, newNote.Trim(), newCountry, bk, ac, ho);
        adding = false;

        if (ok)
        {
            var wasEdit = editingId.HasValue;
            addSuccess = wasEdit ? Lang.T("recip_updated") : Lang.T("recip_added");
            editingId = null;
            await ClearFormFieldsAsync();
            await Reload();
        }
        else addError = err;
    }

    static string AccountKey(string? s) =>
        string.IsNullOrEmpty(s) ? "" : string.Concat(s.Where(char.IsLetterOrDigit)).ToUpperInvariant();

    static string Last4Digits(string? acct)
    {
        var d = AccountKey(acct);
        return d.Length <= 4 ? d : d[^4..];
    }

    async Task DeleteRecipient(int id)
    {
        await Api.DeleteRecipientAsync(id);
        if (editingId == id) CancelEdit();
        await Reload();
    }

    static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}".ToUpper() : name[..Math.Min(2, name.Length)].ToUpper();
    }

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
