@page "/recipients"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-dash-page">
    <DashNav Active="recipients" />
    <div class="sp-dash-content">

        <div class="sp-page-header">
            <a href="/dashboard" class="sp-back-circle"><i class="fa-solid fa-arrow-left"></i></a>
            <div class="sp-page-icon qi-purple"><i class="fa-solid fa-users"></i></div>
            <div>
                <div class="sp-page-title">@Lang.T("recip_title")</div>
                <div class="sp-page-sub">@Lang.T("recip_sub")</div>
            </div>
        </div>

        <div class="sp-recip-grid">

            <div>
                @if (loading)
                {
                    <MudPaper Class="mud-elevation-1 pa-6" Style="border-radius:16px;text-align:center">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                    </MudPaper>
                }
                else if (recipients.Count == 0)
                {
                    <MudPaper Class="mud-elevation-1 pa-8" Style="border-radius:16px;text-align:center">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Style="font-size:42px;color:var(--gray-border)" />
                        <MudText Typo="Typo.body1" Style="color:var(--text-muted);margin-top:12px">@Lang.T("recip_empty")</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="mud-elevation-1" Style="border-radius:16px;overflow:hidden">
                        <MudList T="RecipientResponse" Padding="false">
                            @foreach (var (r, idx) in recipients.Select((x, i) => (x, i)))
                            {
                                <MudListItem T="RecipientResponse" Style="@($"padding:14px 20px;{(idx < recipients.Count - 1 ? "border-bottom:1px solid var(--gray-border)" : "")}")">
                                    <div style="display:flex;align-items:flex-start;gap:14px">
                                        <MudAvatar Style="background:#7048e8;color:white;font-weight:700;flex-shrink:0">
                                            @GetInitials(r.Name)
                                        </MudAvatar>
                                        <div style="flex:1;min-width:0">
                                            <MudText Typo="Typo.body2" Style="font-weight:600;color:var(--navy)">@r.Name</MudText>
                                            <MudText Typo="Typo.caption" Style="color:var(--text-sub);line-height:1.4">
                                                @if (!string.IsNullOrEmpty(r.Phone))
                                                {
                                                    <span><MudIcon Icon="@Icons.Material.Filled.Phone" Style="font-size:11px;vertical-align:middle" /> @r.Phone</span>
                                                }
                                                else
                                                {
                                                    <span style="color:var(--text-muted)">—</span>
                                                }
                                                @if (!string.IsNullOrEmpty(r.BankName) || !string.IsNullOrEmpty(r.AccountNumber) || !string.IsNullOrEmpty(r.SwiftBic))
                                                {
                                                    <span> · @(string.IsNullOrEmpty(r.BankName) ? "" : r.BankName + " ")</span>
                                                    @if (!string.IsNullOrEmpty(r.SwiftBic))
                                                    {
                                                        <span>SWIFT @r.SwiftBic </span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(r.AccountNumber))
                                                    {
                                                        <span>****@Last4Digits(r.AccountNumber)</span>
                                                    }
                                                }
                                                @if (!string.IsNullOrEmpty(r.Note)) { <span> · @r.Note</span> }
                                            </MudText>
                                        </div>
                                        <div style="display:flex;flex-wrap:wrap;gap:6px;flex-shrink:0;justify-content:flex-end">
                                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                                       OnClick="() => StartEdit(r)" Style="border-radius:8px;font-size:11px">
                                                @Lang.T("recip_edit")
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                       Href="@($"/transfer?recipientId={r.Id}")"
                                                       StartIcon="@Icons.Material.Filled.Send"
                                                       Style="border-radius:8px;font-size:11px">
                                                @Lang.T("recip_send")
                                            </MudButton>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                           Variant="Variant.Outlined" Style="border-radius:8px"
                                                           OnClick="() => DeleteRecipient(r.Id)" />
                                        </div>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                }
            </div>

            <MudPaper Class="sp-side-card mud-elevation-1" Style="border-radius:16px;padding:24px">
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:var(--navy);margin-bottom:1rem;display:flex;align-items:center;gap:8px">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Style="color:#7048e8" />
                    @(editingId.HasValue ? Lang.T("recip_edit") : Lang.T("recip_add_title"))
                </MudText>

                @if (!string.IsNullOrEmpty(addError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@addError</MudAlert>
                }
                @if (!string.IsNullOrEmpty(addSuccess))
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@addSuccess</MudAlert>
                }

                <MudTextField @bind-Value="newName"
                              Label="@Lang.T("recip_name")"
                              Placeholder="Nguyen Van A"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              FullWidth="true"
                              Class="mb-3" />

                <MudTextField @bind-Value="newPhone"
                              Label="@Lang.T("recip_phone")"
                              Placeholder="@Lang.T("recip_phone_ph")"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Phone"
                              FullWidth="true"
                              Class="mb-3" />

                <MudTextField @bind-Value="newBank"
                              Label="@Lang.T("recip_bank")"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.AccountBalance"
                              FullWidth="true"
                              Class="mb-3" />

                <MudTextField @bind-Value="newAccount"
                              Label="@Lang.T("recip_account")"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Class="mb-3" />

                <MudTextField @bind-Value="newHolder"
                              Label="@Lang.T("recip_holder")"
                              Placeholder="@Lang.T("recip_holder_ph")"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Class="mb-3" />

                <MudTextField @bind-Value="newSwift"
                              Label="@Lang.T("recip_swift")"
                              Placeholder="BIDVVNVX"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Numbers"
                              FullWidth="true"
                              Class="mb-3"
                              HelperText="@Lang.T("recip_swift_help")"
                              HelperTextOnFocus="true" />

                <MudTextField @bind-Value="newNote"
                              Label="@Lang.T("recip_note")"
                              Placeholder="@Lang.T("recip_note_ph")"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Notes"
                              FullWidth="true"
                              Class="mb-4" />

                <MudStack Row="true" Spacing="2">
                    @if (editingId.HasValue)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                                   OnClick="CancelEdit">@Lang.T("recip_cancel")</MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth="true" Size="Size.Large"
                               OnClick="SaveRecipient" Disabled="@adding"
                               StartIcon="@Icons.Material.Filled.Save"
                               Style="border-radius:10px;font-weight:700;height:48px">
                        @if (adding)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        @(editingId.HasValue ? Lang.T("recip_save") : Lang.T("recip_add_btn"))
                    </MudButton>
                </MudStack>
            </MudPaper>
        </div>
    </div>
</div>

@code {
    List<RecipientResponse> recipients = [];
    bool loading = true;
    bool adding;
    int? editingId;
    string newName = "", newPhone = "", newNote = "", newBank = "", newAccount = "", newHolder = "", newSwift = "";
    string addError = "", addSuccess = "";

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var token = await LocalStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token)) { Nav.NavigateTo("/login"); return; }
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);
        await Reload();
    }

    async Task Reload()
    {
        loading = true;
        recipients = await Api.GetRecipientsAsync();
        loading = false;
    }

    void StartEdit(RecipientResponse r)
    {
        addError = addSuccess = "";
        editingId = r.Id;
        newName = r.Name;
        newPhone = r.Phone ?? "";
        newNote = r.Note;
        newBank = r.BankName ?? "";
        newAccount = r.AccountNumber ?? "";
        newHolder = r.AccountHolderName ?? "";
        newSwift = r.SwiftBic ?? "";
    }

    void CancelEdit()
    {
        editingId = null;
        ClearFormFields();
        addError = addSuccess = "";
    }

    void ClearFormFields()
    {
        newName = newPhone = newNote = newBank = newAccount = newHolder = newSwift = "";
    }

    async Task SaveRecipient()
    {
        addError = ""; addSuccess = "";
        if (string.IsNullOrWhiteSpace(newName))
        { addError = Lang.T("recip_err_required"); return; }

        var ph = string.IsNullOrWhiteSpace(newPhone) ? null : newPhone.Trim();
        var bk = string.IsNullOrWhiteSpace(newBank) ? null : newBank.Trim();
        var ac = string.IsNullOrWhiteSpace(newAccount) ? null : newAccount.Trim();
        var ho = string.IsNullOrWhiteSpace(newHolder) ? null : newHolder.Trim();
        var sw = string.IsNullOrWhiteSpace(newSwift) ? null : newSwift.Trim();

        if (string.IsNullOrEmpty(bk) || string.IsNullOrEmpty(ac) || string.IsNullOrEmpty(ho) || string.IsNullOrEmpty(sw))
        { addError = Lang.T("recip_err_bank_full"); return; }

        if (AccountKey(ac).Length < 6)
        { addError = Lang.T("recip_err_account"); return; }

        if (!IsValidBic(sw))
        { addError = Lang.T("recip_err_swift"); return; }

        adding = true;
        (bool ok, _, string err) = editingId is int eid
            ? await Api.UpdateRecipientAsync(eid, newName.Trim(), ph, newNote.Trim(), bk, ac, ho, sw)
            : await Api.AddRecipientAsync(newName.Trim(), ph, newNote.Trim(), bk, ac, ho, sw);
        adding = false;

        if (ok)
        {
            var wasEdit = editingId.HasValue;
            addSuccess = wasEdit ? Lang.T("recip_updated") : Lang.T("recip_added");
            editingId = null;
            ClearFormFields();
            await Reload();
        }
        else addError = err;
    }

    static string AccountKey(string? s) =>
        string.IsNullOrEmpty(s) ? "" : string.Concat(s.Where(char.IsLetterOrDigit)).ToUpperInvariant();

    static bool IsValidBic(string swift)
    {
        var s = string.Concat(swift.Trim().ToUpperInvariant().Where(c =>
            c is >= 'A' and <= 'Z' || char.IsDigit(c)));
        if (s.Length is not (8 or 11)) return false;
        for (var i = 0; i < 6; i++)
            if (!char.IsLetter(s[i])) return false;
        for (var i = 6; i < 8; i++)
            if (!char.IsLetterOrDigit(s[i])) return false;
        if (s.Length == 11)
            for (var i = 8; i < 11; i++)
                if (!char.IsLetterOrDigit(s[i])) return false;
        return true;
    }

    static string Last4Digits(string? acct)
    {
        var d = AccountKey(acct);
        return d.Length <= 4 ? d : d[^4..];
    }

    async Task DeleteRecipient(int id)
    {
        await Api.DeleteRecipientAsync(id);
        if (editingId == id) CancelEdit();
        await Reload();
    }

    static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}".ToUpper() : name[..Math.Min(2, name.Length)].ToUpper();
    }

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
