@page "/recipients"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-dash-page">
    <DashNav Active="recipients" />
    <div class="sp-dash-content">

        <div class="sp-page-header">
            <a href="/dashboard" class="sp-back-circle"><i class="fa-solid fa-arrow-left"></i></a>
            <div class="sp-page-icon qi-purple"><i class="fa-solid fa-users"></i></div>
            <div>
                <div class="sp-page-title">@Lang.T("recip_title")</div>
                <div class="sp-page-sub">@Lang.T("recip_sub")</div>
            </div>
        </div>

        <div class="sp-recip-grid">

            <!-- LEFT: list -->
            <div>
                @if (loading)
                {
                    <MudPaper Class="mud-elevation-1 pa-6" Style="border-radius:16px;text-align:center">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                    </MudPaper>
                }
                else if (recipients.Count == 0)
                {
                    <MudPaper Class="mud-elevation-1 pa-8" Style="border-radius:16px;text-align:center">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Style="font-size:42px;color:var(--gray-border)" />
                        <MudText Typo="Typo.body1" Style="color:var(--text-muted);margin-top:12px">@Lang.T("recip_empty")</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="mud-elevation-1" Style="border-radius:16px;overflow:hidden">
                        <MudList T="RecipientResponse" Padding="false">
                            @foreach (var (r, idx) in recipients.Select((x, i) => (x, i)))
                            {
                                <MudListItem T="RecipientResponse" Style="@($"padding:14px 20px;{(idx < recipients.Count - 1 ? "border-bottom:1px solid var(--gray-border)" : "")}")">
                                    <div style="display:flex;align-items:center;gap:14px">
                                        <MudAvatar Style="background:#7048e8;color:white;font-weight:700;flex-shrink:0">
                                            @GetInitials(r.Name)
                                        </MudAvatar>
                                        <div style="flex:1;min-width:0">
                                            <MudText Typo="Typo.body2" Style="font-weight:600;color:var(--navy)">@r.Name</MudText>
                                            <MudText Typo="Typo.caption" Style="color:var(--text-sub)">
                                                <MudIcon Icon="@Icons.Material.Filled.Phone" Style="font-size:11px;vertical-align:middle" />
                                                @r.Phone
                                                @if (!string.IsNullOrEmpty(r.Note)) { <span> · @r.Note</span> }
                                            </MudText>
                                        </div>
                                        <div style="display:flex;gap:8px;flex-shrink:0">
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Href="@($"/transfer?phone={Uri.EscapeDataString(r.Phone)}")"
                                                       StartIcon="@Icons.Material.Filled.Send"
                                                       Style="border-radius:8px;font-size:12px">
                                                @Lang.T("recip_send")
                                            </MudButton>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           Variant="Variant.Outlined"
                                                           Style="border-radius:8px"
                                                           OnClick="() => DeleteRecipient(r.Id)" />
                                        </div>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                }
            </div>

            <!-- RIGHT: add form -->
            <MudPaper Class="sp-side-card mud-elevation-1" Style="border-radius:16px;padding:24px">
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:var(--navy);margin-bottom:1rem;display:flex;align-items:center;gap:8px">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Style="color:#7048e8" />
                    @Lang.T("recip_add_title")
                </MudText>

                @if (!string.IsNullOrEmpty(addError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@addError</MudAlert>
                }
                @if (!string.IsNullOrEmpty(addSuccess))
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@addSuccess</MudAlert>
                }

                <MudTextField @bind-Value="newName"
                              Label="@Lang.T("recip_name")"
                              Placeholder="Nguyen Van A"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              FullWidth="true"
                              Class="mb-3" />

                <MudTextField @bind-Value="newPhone"
                              Label="@Lang.T("recip_phone")"
                              Placeholder="090-1234-5678"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Phone"
                              FullWidth="true"
                              Class="mb-3" />

                <MudTextField @bind-Value="newNote"
                              Label="@Lang.T("recip_note")"
                              Placeholder="@Lang.T("recip_note_ph")"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Notes"
                              FullWidth="true"
                              Class="mb-4" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Size="Size.Large"
                           OnClick="AddRecipient" Disabled="@adding"
                           StartIcon="@Icons.Material.Filled.Add"
                           Style="border-radius:10px;font-weight:700;height:48px">
                    @if (adding)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @Lang.T("recip_add_btn")
                </MudButton>
            </MudPaper>
        </div>
    </div>
</div>

@code {
    List<RecipientResponse> recipients = [];
    bool loading = true;
    bool adding;
    string newName = "", newPhone = "", newNote = "";
    string addError = "", addSuccess = "";

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var token = await LocalStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token)) { Nav.NavigateTo("/login"); return; }
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);
        await Reload();
    }

    async Task Reload()
    {
        loading = true;
        recipients = await Api.GetRecipientsAsync();
        loading = false;
    }

    async Task AddRecipient()
    {
        addError = ""; addSuccess = "";
        if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newPhone))
        { addError = Lang.T("recip_err_required"); return; }

        adding = true;
        var (ok, _, err) = await Api.AddRecipientAsync(newName.Trim(), newPhone.Trim(), newNote.Trim());
        adding = false;

        if (ok) { addSuccess = Lang.T("recip_added"); newName = newPhone = newNote = ""; await Reload(); }
        else addError = err;
    }

    async Task DeleteRecipient(int id)
    {
        await Api.DeleteRecipientAsync(id);
        await Reload();
    }

    static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}".ToUpper() : name[..Math.Min(2, name.Length)].ToUpper();
    }

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
