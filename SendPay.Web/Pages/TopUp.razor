@page "/topup"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-dash-page">
    <DashNav Active="topup" />
    <div class="sp-dash-content">

        <div class="sp-page-header">
            <a href="/dashboard" class="sp-back-circle"><i class="fa-solid fa-arrow-left"></i></a>
            <div>
                <h1 class="sp-page-title">@Lang.T("topup_title")</h1>
                <p class="sp-page-sub">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:var(--green);font-size:14px;vertical-align:middle" />
                    @Lang.T("topup_free")
                </p>
            </div>
        </div>

        <div class="sp-topup-grid">

            <!-- LEFT: amount display + quick amounts -->
            <div>
                <MudPaper Class="sp-amount-display mud-elevation-2" Style="margin-bottom:1.5rem;text-align:center;padding:28px 24px;border-radius:16px;background:linear-gradient(135deg,var(--navy),#1a3260)">
                    <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.65);text-transform:uppercase;letter-spacing:.5px;font-weight:600">
                        @Lang.T("topup_amount_lbl")
                    </MudText>
                    <MudText Typo="Typo.h3" Style="color:white;font-weight:800;letter-spacing:-2px;margin:10px 0">
                        ¥@amount.ToString("N0")
                    </MudText>
                    <MudChip T="string" Color="Color.Default" Style="background:rgba(255,255,255,.15);color:white;font-weight:700">
                        🇯🇵 JPY
                    </MudChip>
                </MudPaper>

                <MudText Typo="Typo.subtitle2" Style="color:var(--navy);font-weight:700;margin-bottom:12px">@Lang.T("topup_quick")</MudText>
                <div class="sp-topup-quick-grid">
                    @foreach (var amt in new[] { 5_000m, 10_000m, 30_000m, 50_000m, 100_000m, 200_000m })
                    {
                        <MudButton Variant="@(amount == amt ? Variant.Filled : Variant.Outlined)"
                                   Color="@(amount == amt ? Color.Primary : Color.Default)"
                                   OnClick="() => amount = amt"
                                   Style="border-radius:10px;font-weight:700">
                            ¥@amt.ToString("N0")
                        </MudButton>
                    }
                </div>
            </div>

            <!-- RIGHT: input + CTA -->
            <div class="sp-side-card">
                @if (balance > 0)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;background:var(--navy);border-radius:10px;padding:12px 16px">
                        <span style="color:rgba(255,255,255,.7);font-size:12px">
                            <i class="fa-solid fa-wallet" style="margin-right:6px"></i>@Lang.T("dash_bal_label")
                        </span>
                        <strong style="color:white;font-size:16px">¥@balance.ToString("N0")</strong>
                    </div>
                }

                <MudPaper Class="mud-elevation-0 mb-4" Style="background:var(--gray-bg);border-radius:12px;padding:16px;border:1px solid var(--gray-border)">
                    <MudText Typo="Typo.caption" Style="font-weight:700;color:var(--navy);margin-bottom:8px">
                        @Lang.T("topup_jp_bank_title")
                    </MudText>
                    @if (!string.IsNullOrEmpty(profileJapanBank) && !string.IsNullOrEmpty(profileJapanUrl))
                    {
                        <MudText Typo="Typo.body2" Style="font-weight:600;margin-bottom:10px">@profileJapanBank</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true"
                                   Href="@profileJapanUrl" Target="_blank" Rel="noopener noreferrer"
                                   StartIcon="@Icons.Material.Filled.OpenInNew" Style="border-radius:10px;font-weight:700">
                            @Lang.T("topup_jp_bank_open")
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Style="color:var(--text-sub)">@Lang.T("topup_jp_bank_none")</MudText>
                    }
                </MudPaper>

                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">@Lang.T("topup_free")</MudAlert>
                <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-4" Style="font-size:12px">@Lang.T("topup_no_otp_hint")</MudAlert>

                <MudTextField @bind-Value="amount"
                              Label="@Lang.T("topup_custom_lbl")"
                              Placeholder="@Lang.T("topup_custom_ph")"
                              InputType="InputType.Number"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentText="¥"
                              FullWidth="true"
                              Class="mb-4" />

                @if (!string.IsNullOrEmpty(successMsg))
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@successMsg</MudAlert>
                }
                @if (!string.IsNullOrEmpty(error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Size="Size.Large"
                           OnClick="HandleTopUp" Disabled="@loading"
                           StartIcon="@Icons.Material.Filled.Add"
                           Style="border-radius:10px;font-weight:700;height:50px;font-size:15px">
                    @if (loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>@Lang.T("topup_loading")</span>
                    }
                    else
                    {
                        <span>@Lang.T("topup_btn") ¥@amount.ToString("N0")</span>
                    }
                </MudButton>

                <MudPaper Class="mud-elevation-0 mt-4" Style="background:var(--gray-bg);border-radius:12px;padding:16px">
                    <MudText Typo="Typo.caption" Style="font-weight:700;color:var(--navy);display:flex;align-items:center;gap:6px;margin-bottom:8px">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Style="color:var(--red);font-size:14px" />
                        @Lang.T("topup_guide_title")
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color:var(--text-sub);line-height:1.9">
                        • @Lang.T("topup_guide_min")<br />
                        • @Lang.T("topup_guide_fee")<br />
                        • @Lang.T("topup_guide_instant")
                    </MudText>
                </MudPaper>
            </div>

        </div>
    </div>
</div>

@code {
    decimal amount = 10_000;
    decimal balance;
    string error = "", successMsg = "";
    bool loading;
    string profileJapanBank = "";
    string profileJapanUrl = "";

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var token = await LocalStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token)) Nav.NavigateTo("/login");
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);
        var wallet = await Api.GetWalletAsync();
        balance = wallet?.Balance ?? 0;
        var p = await Api.GetProfileAsync();
        if (p != null)
        {
            profileJapanBank = p.JapanBankName ?? "";
            profileJapanUrl = p.JapanBankTopUpUrl ?? "";
        }
    }

    async Task HandleTopUp()
    {
        error = successMsg = "";
        if (amount < 1_000) { error = "Min ¥1,000"; return; }
        loading = true;
        var (ok, data, err) = await Api.TopUpAsync(amount);
        loading = false;

        if (ok && data != null)
        {
            balance = data.Balance;
            successMsg = $"{Lang.T("topup_success")} +¥{amount:N0} · ¥{data.Balance:N0}";
        }
        else error = err;
    }

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
