@page "/register"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-auth-page sp-register-page">
    <MudPaper Class="sp-auth-card sp-register-card mud-elevation-3" Elevation="0">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:28px">
            <img src="/images/logo.png" alt="SendPay" class="sp-logo-img sp-logo-img--auth" />
            <LangSelector />
        </div>

        <MudText Typo="Typo.h5" Style="font-weight:800;color:var(--navy);margin-bottom:6px">@Lang.T("reg_title")</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--text-sub);margin-bottom:24px">@Lang.T("reg_subtitle")</MudText>

        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@error</MudAlert>
        }

        <!-- SECTION 1 -->
        <div class="sp-reg-section">
            <MudText Typo="Typo.subtitle2" Class="sp-reg-section-title">
                <i class="fa-solid fa-user mr-1"></i> @Lang.T("reg_sec1")
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="fullName"
                                  Label="@(Lang.T("reg_name") + " *")"
                                  Placeholder="@Lang.T("reg_name_ph")"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person"
                                  FullWidth="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="dateOfBirth"
                                   Label="@(Lang.T("reg_dob") + " *")"
                                   Variant="Variant.Outlined"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                                   Style="width:100%"
                                   MaxDate="DateTime.Today.AddYears(-18)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="nationality"
                               Label="@(Lang.T("reg_nationality") + " *")"
                               Variant="Variant.Outlined"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.Flag"
                               FullWidth="true">
                        <MudSelectItem Value='""'>@Lang.T("select_ph")</MudSelectItem>
                        <MudSelectItem Value='"VN"'>@Lang.T("reg_country_vn")</MudSelectItem>
                        <MudSelectItem Value='"LK"'>@Lang.T("reg_country_lk")</MudSelectItem>
                        <MudSelectItem Value='"NP"'>@Lang.T("reg_country_np")</MudSelectItem>
                        <MudSelectItem Value='"PH"'>@Lang.T("reg_country_ph")</MudSelectItem>
                        <MudSelectItem Value='"Other"'>@Lang.T("reg_country_other")</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="visaStatus"
                               Label="@(Lang.T("reg_visa") + " *")"
                               Variant="Variant.Outlined"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.CreditCard"
                               FullWidth="true">
                        <MudSelectItem Value='""'>@Lang.T("select_ph")</MudSelectItem>
                        <MudSelectItem Value='"永住者"'>@Lang.T("visa_1")</MudSelectItem>
                        <MudSelectItem Value='"特定技能"'>@Lang.T("visa_2")</MudSelectItem>
                        <MudSelectItem Value='"技能実習"'>@Lang.T("visa_3")</MudSelectItem>
                        <MudSelectItem Value='"留学"'>@Lang.T("visa_4")</MudSelectItem>
                        <MudSelectItem Value='"家族滞在"'>@Lang.T("visa_5")</MudSelectItem>
                        <MudSelectItem Value='"技術・人文知識・国際業務"'>@Lang.T("visa_6")</MudSelectItem>
                        <MudSelectItem Value='"その他"'>@Lang.T("visa_7")</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="email"
                                  Label="@(Lang.T("reg_email") + " *")"
                                  Placeholder="example@email.com"
                                  InputType="InputType.Email"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  UserAttributes='new Dictionary<string, object> { {"autocomplete", "email"} }'
                                  FullWidth="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="phone"
                                  Label="@(Lang.T("reg_phone") + " *")"
                                  Placeholder="@Lang.T("reg_phone_ph")"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Phone"
                                  UserAttributes='new Dictionary<string, object> { {"autocomplete", "tel"} }'
                                  FullWidth="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="password"
                                  Label="@(Lang.T("reg_password") + " *")"
                                  Placeholder="@Lang.T("reg_password_ph")"
                                  InputType="@(showPwd ? InputType.Text : InputType.Password)"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="() => showPwd = !showPwd"
                                  UserAttributes='new Dictionary<string, object> { {"autocomplete", "new-password"} }'
                                  FullWidth="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="passwordConfirm"
                                  Label="@(Lang.T("reg_confirm") + " *")"
                                  Placeholder="@Lang.T("reg_confirm_ph")"
                                  InputType="@(showPwd ? InputType.Text : InputType.Password)"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="() => showPwd = !showPwd"
                                  UserAttributes='new Dictionary<string, object> { {"autocomplete", "new-password"} }'
                                  FullWidth="true" />
                </MudItem>
            </MudGrid>
        </div>

        <!-- SECTION 2 -->
        <div class="sp-reg-section">
            <MudText Typo="Typo.subtitle2" Class="sp-reg-section-title">
                <i class="fa-solid fa-id-card mr-1"></i> @Lang.T("reg_sec2")
            </MudText>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">
                @Lang.T("reg_kyc_notice")
            </MudAlert>

            <MudText Typo="Typo.body2" Style="font-weight:600;margin-bottom:10px">
                @Lang.T("reg_doc_label") <span style="color:var(--red)">*</span>
            </MudText>
            <div class="sp-kyc-options">
                <label class="sp-kyc-option @(docType == "zairyu" ? "selected" : "")">
                    <input type="radio" name="doctype" value="zairyu" @onchange='() => docType = "zairyu"' />
                    <div class="sp-kyc-opt-inner">
                        <i class="fa-solid fa-passport"></i>
                        <div><div class="sp-kyc-opt-title">@Lang.T("reg_zairyu")</div></div>
                    </div>
                </label>
                <label class="sp-kyc-option @(docType == "license" ? "selected" : "")">
                    <input type="radio" name="doctype" value="license" @onchange='() => docType = "license"' />
                    <div class="sp-kyc-opt-inner">
                        <i class="fa-solid fa-car"></i>
                        <div><div class="sp-kyc-opt-title">@Lang.T("reg_license")</div></div>
                    </div>
                </label>
                <label class="sp-kyc-option sp-kyc-option-rec @(docType == "mynumber" ? "selected" : "")">
                    <input type="radio" name="doctype" value="mynumber" @onchange='() => docType = "mynumber"' />
                    <div class="sp-kyc-opt-inner">
                        <i class="fa-solid fa-id-card"></i>
                        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                            <div class="sp-kyc-opt-title">@Lang.T("reg_mynumber")</div>
                            <span class="sp-kyc-badge" style="margin-top:0">@Lang.T("reg_mynumber_sub")</span>
                        </div>
                    </div>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(docType))
            {
                <div class="sp-kyc-upload-area">
                    <div class="sp-kyc-upload-box">
                        <i class="fa-solid fa-camera" style="font-size:28px;color:var(--red);margin-bottom:8px"></i>
                        <div style="font-weight:600;font-size:14px;color:var(--navy)">@Lang.T("reg_front")</div>
                        <div style="font-size:12px;color:var(--text-muted);margin:4px 0 12px">@Lang.T("reg_upload_hint")</div>
                        <input type="file" accept="image/*,.pdf" @onchange='e => docFrontFile = e.Value?.ToString() ?? ""' style="display:none" id="docFront" />
                        <label for="docFront" class="sp-kyc-upload-btn">
                            <i class="fa-solid fa-upload"></i> @Lang.T("reg_upload_btn")
                        </label>
                        @if (!string.IsNullOrEmpty(docFrontFile))
                        {
                            <div class="sp-kyc-file-ok"><i class="fa-solid fa-check-circle"></i> @Lang.T("reg_file_ok")</div>
                        }
                    </div>
                    @if (docType != "mynumber")
                    {
                        <div class="sp-kyc-upload-box">
                            <i class="fa-solid fa-camera" style="font-size:28px;color:var(--text-muted);margin-bottom:8px"></i>
                            <div style="font-weight:600;font-size:14px;color:var(--navy)">@Lang.T("reg_back")</div>
                            <div style="font-size:12px;color:var(--text-muted);margin:4px 0 12px">@Lang.T("reg_upload_hint")</div>
                            <input type="file" accept="image/*,.pdf" @onchange='e => docBackFile = e.Value?.ToString() ?? ""' style="display:none" id="docBack" />
                            <label for="docBack" class="sp-kyc-upload-btn secondary">
                                <i class="fa-solid fa-upload"></i> @Lang.T("reg_upload_btn")
                            </label>
                            @if (!string.IsNullOrEmpty(docBackFile))
                            {
                                <div class="sp-kyc-file-ok"><i class="fa-solid fa-check-circle"></i> @Lang.T("reg_file_ok")</div>
                            }
                        </div>
                    }
                </div>
            }

            <div class="sp-jumin-box" style="margin-top:16px">
                <i class="fa-solid fa-file-lines" style="font-size:24px;color:var(--gold);margin-bottom:8px;display:block"></i>
                <div style="font-size:13px;font-weight:600;color:var(--navy);margin-bottom:4px">@Lang.T("reg_jumin_title")</div>
                <div style="font-size:12px;color:var(--text-muted);margin-bottom:12px">@Lang.T("reg_jumin_sub")</div>
                <input type="file" accept="image/*,.pdf" @onchange='e => juminFile = e.Value?.ToString() ?? ""' style="display:none" id="jumin" />
                <label for="jumin" class="sp-kyc-upload-btn">
                    <i class="fa-solid fa-upload"></i> @Lang.T("reg_jumin_btn")
                </label>
                @if (!string.IsNullOrEmpty(juminFile))
                {
                    <div class="sp-kyc-file-ok" style="margin-top:8px"><i class="fa-solid fa-check-circle"></i> @Lang.T("reg_file_ok")</div>
                }
            </div>
        </div>

        <!-- SECTION 3 -->
        <div class="sp-reg-section">
            <MudText Typo="Typo.subtitle2" Class="sp-reg-section-title">
                <i class="fa-solid fa-check-square mr-1"></i> @Lang.T("reg_sec3")
            </MudText>
            <MudCheckBox @bind-Value="agreeTerms" Color="Color.Primary" Dense="true" Class="d-block mb-1">
                <MudText Typo="Typo.body2">@Lang.T("reg_agree1")</MudText>
            </MudCheckBox>
            <MudCheckBox @bind-Value="agreeKyc" Color="Color.Primary" Dense="true" Class="d-block mb-1">
                <MudText Typo="Typo.body2">@Lang.T("reg_agree2")</MudText>
            </MudCheckBox>
            <MudCheckBox @bind-Value="agreeAml" Color="Color.Primary" Dense="true" Class="d-block">
                <MudText Typo="Typo.body2">@Lang.T("reg_agree3")</MudText>
            </MudCheckBox>
        </div>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   OnClick="HandleRegister"
                   Disabled="@loading"
                   StartIcon="@Icons.Material.Filled.HowToReg"
                   Style="border-radius:10px;font-weight:700;height:50px;font-size:15px;margin-top:8px">
            @if (loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>@Lang.T("reg_loading")</span>
            }
            else
            {
                <span>@Lang.T("reg_submit")</span>
            }
        </MudButton>

        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3" Icon="@Icons.Material.Filled.Security">
            @Lang.T("reg_note")
        </MudAlert>

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.body2" Align="Align.Center" Style="color:var(--text-sub)">
            @Lang.T("reg_switch")
            <MudLink Href="/login" Color="Color.Primary" Style="font-weight:600">@Lang.T("reg_switch_link")</MudLink>
        </MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">
            <MudLink Href="/" Color="Color.Primary">@Lang.T("reg_home")</MudLink>
        </MudText>
    </MudPaper>
</div>

@code {
    string fullName = "", email = "", phone = "", password = "", passwordConfirm = "", error = "";
    string nationality = "", visaStatus = "", docType = "";
    string docFrontFile = "", docBackFile = "", juminFile = "";
    DateTime? dateOfBirth = DateTime.Today.AddYears(-25);
    bool loading, agreeTerms, agreeKyc, agreeAml, showPwd;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);
    }

    async Task HandleRegister()
    {
        error = "";

        if (string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(phone) || string.IsNullOrWhiteSpace(password))
        { error = Lang.T("err_fill_all"); return; }

        if (!IsStrongPassword(password))
        { error = Lang.T("err_pw_weak"); return; }

        if (password != passwordConfirm)
        { error = Lang.T("err_pw_mismatch"); return; }

        if (string.IsNullOrEmpty(nationality) || string.IsNullOrEmpty(visaStatus))
        { error = Lang.T("err_select_country"); return; }

        if (string.IsNullOrEmpty(docType))
        { error = Lang.T("err_select_doc"); return; }

        if (string.IsNullOrEmpty(docFrontFile))
        { error = Lang.T("settings_kyc_err_front"); return; }

        if (docType != "mynumber" && string.IsNullOrEmpty(docBackFile))
        { error = Lang.T("settings_kyc_err_back"); return; }

        if (!agreeTerms || !agreeKyc || !agreeAml)
        { error = Lang.T("err_agree_all"); return; }

        loading = true;
        var (ok, data, err) = await Api.RegisterAsync(fullName, email, phone, password);
        loading = false;

        if (ok && data != null)
        {
            await Api.PersistAuthAsync(data);
            Nav.NavigateTo(data.IsAdmin ? "/admin" : "/dashboard");
        }
        else error = err;
    }

    static bool IsStrongPassword(string pwd) =>
        pwd.Length >= 8 &&
        pwd.Any(char.IsUpper) &&
        pwd.Any(c => !char.IsLetterOrDigit(c));

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
