@page "/admin"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav

<div class="sp-admin-page">

    <!-- Top nav -->
    <nav class="sp-admin-nav">
        <a class="sp-admin-logo" href="/admin">
            <img src="/images/logo.png" alt="SendPay" class="sp-logo-img sp-logo-img--nav" />
        </a>
        <span class="sp-admin-badge"><i class="fa-solid fa-shield-halved"></i> Admin</span>
        <div class="sp-admin-nav-right">
            <div class="sp-dash-user">
                <div class="sp-dash-avatar sp-admin-avatar">@GetInitials(adminName)</div>
                <span style="font-size:13px;font-weight:600;color:rgba(255,255,255,.88)">@adminName</span>
            </div>
            <button class="sp-dash-logout" @onclick="Logout">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span class="sp-dash-logout-txt">Đăng xuất</span>
            </button>
        </div>
    </nav>

    <div class="sp-admin-content">

        <!-- Stats -->
        @if (stats is not null)
        {
            <MudGrid Spacing="3" Class="mb-4">
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="sp-stat-card mud-elevation-1" Style="border-radius:16px;padding:20px">
                        <div style="display:flex;align-items:center;gap:12px">
                            <div class="sc-icon sc-icon-blue"><i class="fa-solid fa-users"></i></div>
                            <div>
                                <MudText Typo="Typo.caption" Style="color:var(--text-muted)">Tổng người dùng</MudText>
                                <MudText Typo="Typo.h6" Style="font-weight:800;color:var(--navy)">@stats.TotalUsers.ToString("N0")</MudText>
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="sp-stat-card mud-elevation-1" Style="border-radius:16px;padding:20px">
                        <div style="display:flex;align-items:center;gap:12px">
                            <div class="sc-icon sc-icon-green"><i class="fa-solid fa-user-check"></i></div>
                            <div>
                                <MudText Typo="Typo.caption" Style="color:var(--text-muted)">Đang hoạt động</MudText>
                                <MudText Typo="Typo.h6" Style="font-weight:800;color:var(--navy)">@stats.ActiveUsers.ToString("N0")</MudText>
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="sp-stat-card mud-elevation-1" Style="border-radius:16px;padding:20px">
                        <div style="display:flex;align-items:center;gap:12px">
                            <div class="sc-icon sc-icon-red"><i class="fa-solid fa-arrow-right-arrow-left"></i></div>
                            <div>
                                <MudText Typo="Typo.caption" Style="color:var(--text-muted)">GD hôm nay</MudText>
                                <MudText Typo="Typo.h6" Style="font-weight:800;color:var(--navy)">@stats.TodayTransactions.ToString("N0")</MudText>
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="sp-stat-card mud-elevation-1" Style="border-radius:16px;padding:20px">
                        <div style="display:flex;align-items:center;gap:12px">
                            <div class="sc-icon sc-icon-gold"><i class="fa-solid fa-coins"></i></div>
                            <div>
                                <MudText Typo="Typo.caption" Style="color:var(--text-muted)">Doanh số hôm nay</MudText>
                                <MudText Typo="Typo.h6" Style="font-weight:800;color:var(--navy)">@FormatVnd(stats.TodayVolume)</MudText>
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }

        <!-- Main Panel -->
        <MudPaper Class="sp-admin-panel mud-elevation-1" Style="border-radius:16px;overflow:hidden">
            <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
                     ActivePanelIndexChanged="OnTabChanged">

                <!-- Users Tab -->
                <MudTabPanel Icon="@Icons.Material.Filled.People" Text="Người dùng">
                    <div style="padding:16px 20px;border-bottom:1px solid var(--gray-border);display:flex;align-items:center;gap:12px">
                        <MudTextField @bind-Value="userSearch"
                                      Placeholder="Tìm tên, email, SĐT..."
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      DebounceInterval="400"
                                      OnDebounceIntervalElapsed="OnSearchDebounced"
                                      Style="max-width:380px"
                                      Margin="Margin.Dense" />
                    </div>

                    @if (usersLoading)
                    {
                        <div style="padding:48px;text-align:center">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                        </div>
                    }
                    else if (users.Count == 0)
                    {
                        <div style="padding:48px;text-align:center">
                            <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size:42px;color:var(--gray-border)" />
                            <MudText Typo="Typo.body1" Style="color:var(--text-muted);margin-top:10px">Không có người dùng nào</MudText>
                        </div>
                    }
                    else
                    {
                        <div class="sp-table-wrap">
                            <MudTable Items="@users" Hover="true" Elevation="0" Dense="true"
                                      RowStyle="border-bottom:1px solid var(--gray-border)">
                                <HeaderContent>
                                    <MudTh>#</MudTh>
                                    <MudTh>Họ tên</MudTh>
                                    <MudTh>Email</MudTh>
                                    <MudTh>SĐT</MudTh>
                                    <MudTh>Số dư</MudTh>
                                    <MudTh>Trạng thái</MudTh>
                                    <MudTh>Vai trò</MudTh>
                                    <MudTh>Ngày tạo</MudTh>
                                    <MudTh>Thao tác</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Style="color:var(--text-muted);font-size:12px">@context.Id</MudTd>
                                    <MudTd><strong>@context.FullName</strong></MudTd>
                                    <MudTd>@context.Email</MudTd>
                                    <MudTd>@context.Phone</MudTd>
                                    <MudTd><strong>@FormatVnd(context.Balance)</strong></MudTd>
                                    <MudTd>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(context.IsActive ? Color.Success : Color.Error)"
                                                 Style="height:22px;font-size:11px">
                                            @(context.IsActive ? "Hoạt động" : "Bị khóa")
                                        </MudChip>
                                    </MudTd>
                                    <MudTd>
                                        @if (context.IsAdmin)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                     Icon="@Icons.Material.Filled.Shield" Style="height:22px;font-size:11px">
                                                Admin
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Style="color:var(--text-muted)">Người dùng</MudText>
                                        }
                                    </MudTd>
                                    <MudTd Style="color:var(--text-sub);font-size:12px">@context.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                    <MudTd>
                                        <div style="display:flex;gap:6px">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small" Color="Color.Primary"
                                                                           OnClick="() => OpenEdit(context)" />
                                            @if (!context.IsAdmin)
                                            {
                                                <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
                                                               Size="Size.Small"
                                                               Color="@(context.IsActive ? Color.Warning : Color.Success)"
                                                               OnClick="() => ToggleUser(context.Id)" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Size="Size.Small" Color="Color.Error"
                                                               OnClick="() => ConfirmDeleteUser(context)" />
                                            }
                                        </div>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>

                        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 20px;border-top:1px solid var(--gray-border)">
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ChevronLeft"
                                       Disabled="@(userPage <= 1)" OnClick="PrevUserPage">Trước</MudButton>
                            <MudChip T="string" Color="Color.Default" Style="font-weight:600">Trang @userPage</MudChip>
                            <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ChevronRight"
                                       Disabled="@(users.Count < 15)" OnClick="NextUserPage">Sau</MudButton>
                        </div>
                    }
                </MudTabPanel>

                <!-- Transactions Tab -->
                <MudTabPanel Icon="@Icons.Material.Filled.Receipt" Text="Giao dịch">
                    @if (txLoading)
                    {
                        <div style="padding:48px;text-align:center">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                        </div>
                    }
                    else if (transactions.Count == 0)
                    {
                        <div style="padding:48px;text-align:center">
                            <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size:42px;color:var(--gray-border)" />
                            <MudText Typo="Typo.body1" Style="color:var(--text-muted);margin-top:10px">Chưa có giao dịch nào</MudText>
                        </div>
                    }
                    else
                    {
                        <div class="sp-table-wrap">
                            <MudTable Items="@transactions" Hover="true" Elevation="0" Dense="true"
                                      RowStyle="border-bottom:1px solid var(--gray-border)">
                                <HeaderContent>
                                    <MudTh>#</MudTh>
                                    <MudTh>Người gửi</MudTh>
                                    <MudTh>Người nhận</MudTh>
                                    <MudTh>Số tiền</MudTh>
                                    <MudTh>Ghi chú</MudTh>
                                    <MudTh>Loại</MudTh>
                                    <MudTh>Trạng thái</MudTh>
                                    <MudTh>Thời gian</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Style="color:var(--text-muted);font-size:12px">@context.Id</MudTd>
                                    <MudTd><strong>@context.SenderName</strong></MudTd>
                                    <MudTd>@context.ReceiverName</MudTd>
                                    <MudTd><strong style="color:var(--navy)">@FormatVnd(context.Amount)</strong></MudTd>
                                    <MudTd Style="color:var(--text-sub);font-size:12px">@(string.IsNullOrEmpty(context.Note) ? "—" : context.Note)</MudTd>
                                    <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Info" Style="height:22px;font-size:11px">@context.Type</MudChip></MudTd>
                                    <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Success" Style="height:22px;font-size:11px">@context.Status</MudChip></MudTd>
                                    <MudTd Style="color:var(--text-sub);font-size:12px">@context.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>

                        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 20px;border-top:1px solid var(--gray-border)">
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ChevronLeft"
                                       Disabled="@(txPage <= 1)" OnClick="PrevTxPage">Trước</MudButton>
                            <MudChip T="string" Color="Color.Default" Style="font-weight:600">Trang @txPage</MudChip>
                            <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ChevronRight"
                                       Disabled="@(transactions.Count < 15)" OnClick="NextTxPage">Sau</MudButton>
                        </div>
                    }
                </MudTabPanel>

                <MudTabPanel Icon="@Icons.Material.Filled.AccountBalanceWallet" Text="Lệnh nạp">
                    <div style="padding:16px 20px">
                        @if (!string.IsNullOrEmpty(topupActionMsg))
                        {
                            <MudAlert Dense="true" Class="mb-3"
                                      Severity="@(topupActionErr ? Severity.Error : Severity.Success)">@topupActionMsg</MudAlert>
                        }
                        <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:16px">
                            <MudTextField @bind-Value="topupStatusFilter" Label="Trạng thái (Pending/Matched/Expired)"
                                          Style="max-width:260px" Margin="Margin.Dense" Variant="Variant.Outlined" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadTopUpIntents">Tải lại</MudButton>
                        </div>
                        @if (topupLoading)
                        {
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (topupIntents.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Style="color:var(--text-muted)">Không có lệnh.</MudText>
                        }
                        else
                        {
                            <div class="sp-table-wrap">
                                <MudTable Items="@topupIntents" Hover="true" Elevation="0" Dense="true">
                                    <HeaderContent>
                                        <MudTh>#</MudTh>
                                        <MudTh>User</MudTh>
                                        <MudTh>Số tiền</MudTh>
                                        <MudTh>Mã CK</MudTh>
                                        <MudTh>TT</MudTh>
                                        <MudTh>Tạo</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Id</MudTd>
                                        <MudTd>@context.UserName<br/><span style="font-size:11px;color:var(--text-muted)">@context.UserEmail</span></MudTd>
                                        <MudTd><strong>@FormatJpy(context.ExpectedAmount)</strong></MudTd>
                                        <MudTd Style="font-size:11px;word-break:break-all;max-width:180px">@context.ReferenceCode</MudTd>
                                        <MudTd><MudChip T="string" Size="Size.Small">@context.Status</MudChip></MudTd>
                                        <MudTd Style="font-size:12px">@context.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</MudTd>
                                        <MudTd>
                                            @if (string.Equals(context.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small"
                                                               OnClick="@(() => ConfirmTopUp(context.Id))" />
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                        }

                        <MudText Typo="Typo.subtitle2" Style="margin-top:24px;font-weight:700">Import 1 dòng sao kê người nhận</MudText>
                        <MudText Typo="Typo.caption" Style="color:var(--text-muted);margin-bottom:8px">Memo phải chứa đúng mã tham chiếu; số tiền khớp lệnh Pending.</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="importMemo" Variant="Variant.Outlined" Label="Memo / nội dung" Lines="2" FullWidth="true" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudTextField @bind-Value="importAmount" Variant="Variant.Outlined" Label="Số tiền (JPY)" FullWidth="true" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudTextField @bind-Value="importDateStr" Variant="Variant.Outlined" Label="Ngày (yyyy-MM-dd)" FullWidth="true" />
                            </MudItem>
                        </MudGrid>
                        <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Secondary" OnClick="ImportBankLine" Disabled="@importBusy">
                            @if (importBusy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                            Import &amp; chạy đối soát
                        </MudButton>
                        @if (!string.IsNullOrEmpty(importMsg))
                        {
                            <MudAlert Class="mt-2" Dense="true" Severity="Severity.Info">@importMsg</MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <MudTabPanel Icon="@Icons.Material.Filled.BarChart" Text="Thống kê snapshot">
                    <div style="padding:16px 20px">
                        <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:16px">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadDailyStats">Tải 60 ngày</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="RebuildYesterdayStats">Rebuild hôm qua (UTC)</MudButton>
                        </div>
                        @if (statsJobMsg != null)
                        {
                            <MudAlert Dense="true" Severity="Severity.Success" Class="mb-2">@statsJobMsg</MudAlert>
                        }
                        @if (statsLoading)
                        {
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (dailyStats.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Style="color:var(--text-muted)">Chưa có dữ liệu. Bấm «Tải 60 ngày» hoặc chờ job 01:00 UTC.</MudText>
                        }
                        else
                        {
                            <div class="sp-table-wrap">
                                <MudTable Items="@dailyStats" Hover="true" Elevation="0" Dense="true">
                                    <HeaderContent>
                                        <MudTh>Ngày UTC</MudTh>
                                        <MudTh>Loại</MudTh>
                                        <MudTh>TT</MudTh>
                                        <MudTh>Số GD</MudTh>
                                        <MudTh>Tổng tiền</MudTh>
                                        <MudTh>Phí</MudTh>
                                        <MudTh>Tính lúc</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.StatDate.ToString("yyyy-MM-dd")</MudTd>
                                        <MudTd>@context.TransactionType</MudTd>
                                        <MudTd>@context.Status</MudTd>
                                        <MudTd>@context.Count</MudTd>
                                        <MudTd>@FormatJpy(context.TotalAmount)</MudTd>
                                        <MudTd>@FormatJpy(context.TotalFee)</MudTd>
                                        <MudTd Style="font-size:11px">@context.ComputedAt.ToLocalTime().ToString("dd/MM HH:mm")</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                        }
                    </div>
                </MudTabPanel>

            </MudTabs>
        </MudPaper>

    </div>
</div>

<!-- Edit User Dialog -->
@if (editUser != null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1200" OnClick="CloseEdit" />
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:1300;width:min(500px,94vw)">
        <MudPaper Class="mud-elevation-24" Style="border-radius:20px;overflow:hidden">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 24px;border-bottom:1px solid var(--gray-border)">
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:var(--navy);display:flex;align-items:center;gap:8px">
                    <MudIcon Icon="@Icons.Material.Filled.EditNote" Style="color:var(--red)" />
                    Chỉnh sửa người dùng #@editUser.Id
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseEdit" />
            </div>
            <div style="padding:20px 24px">
                @if (!string.IsNullOrEmpty(editError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@editError</MudAlert>
                }
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="editFullName" Label="Họ tên" Variant="Variant.Outlined"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="editEmail" Label="Email" InputType="InputType.Email"
                                      Variant="Variant.Outlined" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email" FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="editPhone" Label="Số điện thoại"
                                      Variant="Variant.Outlined" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Phone" FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Style="font-weight:700;color:var(--text-muted);margin-bottom:6px">
                            Ngân hàng nạp tiền (Nhật Bản)
                        </MudText>
                        <MudTextField @bind-Value="editJapanBank" Label="Tên ngân hàng hiển thị" Variant="Variant.Outlined"
                                      Placeholder="VD: MUFG / Sumitomo..." FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="editJapanUrl" Label="URL trang nạp/chuyển khoản (https…)"
                                      Variant="Variant.Outlined" Placeholder="https://..." FullWidth="true"
                                      HelperText="Người dùng mở link này từ màn Nạp tiền" />
                    </MudItem>
                </MudGrid>
            </div>
            <div style="padding:0 24px 20px;display:flex;gap:10px">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="SaveEdit" Disabled="@editSaving"
                           StartIcon="@Icons.Material.Filled.Save" Style="border-radius:10px;font-weight:700">
                    @if (editSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Lưu thay đổi
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="CloseEdit" Style="border-radius:10px;min-width:80px">Hủy</MudButton>
            </div>
        </MudPaper>
    </div>
}

<!-- Delete Confirm Dialog -->
@if (deleteUser != null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1200" OnClick="CloseDelete" />
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:1300;width:min(420px,94vw)">
        <MudPaper Class="mud-elevation-24" Style="border-radius:20px;overflow:hidden">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 24px;border-bottom:1px solid var(--gray-border)">
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:#c92a2a;display:flex;align-items:center;gap:8px">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Style="color:#e67700" />
                    Xác nhận xóa
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseDelete" />
            </div>
            <div style="padding:20px 24px">
                <MudText Typo="Typo.body2" Style="color:var(--text-sub)">
                    Bạn có chắc muốn xóa người dùng <strong>@deleteUser.FullName</strong>?<br />
                    Thao tác này không thể hoàn tác.
                </MudText>
                @if (!string.IsNullOrEmpty(deleteError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@deleteError</MudAlert>
                }
            </div>
            <div style="padding:0 24px 20px;display:flex;gap:10px">
                <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true"
                           OnClick="DoDeleteUser" Disabled="@deleteSaving"
                           StartIcon="@Icons.Material.Filled.Delete" Style="border-radius:10px;font-weight:700">
                    @if (deleteSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Xóa
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="CloseDelete" Style="border-radius:10px;min-width:80px">Hủy</MudButton>
            </div>
        </MudPaper>
    </div>
}

@code {
    string adminName = "";

    AdminStatsResponse? stats;

    List<AdminUserResponse> users = [];
    bool usersLoading;
    int userPage = 1;
    string userSearch = "";

    List<AdminTransactionResponse> transactions = [];
    bool txLoading;
    int txPage = 1;

    List<AdminTopUpIntentResponse> topupIntents = [];
    bool topupLoading;
    string topupStatusFilter = "";
    string importMemo = "";
    string importAmount = "";
    string importDateStr = "";
    string? importMsg;
    string? topupActionMsg;
    bool topupActionErr;
    bool importBusy;

    List<AdminDailyStatResponse> dailyStats = [];
    bool statsLoading;
    string? statsJobMsg;

    AdminUserResponse? editUser;
    string editFullName = "", editEmail = "", editPhone = "", editError = "";
    string editJapanBank = "", editJapanUrl = "";
    decimal editBalance;
    bool editSaving;

    AdminUserResponse? deleteUser;
    string deleteError = "";
    bool deleteSaving;

    protected override async Task OnInitializedAsync()
    {
        var isAdmin = await LocalStorage.GetItemAsync<bool>("isAdmin");
        if (!isAdmin) { Nav.NavigateTo("/login"); return; }
        adminName = await LocalStorage.GetItemAsync<string>("fullName") ?? "Admin";
        importDateStr = DateTime.UtcNow.ToString("yyyy-MM-dd");
        stats = await Api.GetAdminStatsAsync();
        await LoadUsers();
    }

    async Task OnTabChanged(int idx)
    {
        if (idx == 1 && transactions.Count == 0)
            await LoadTransactions();
        if (idx == 2)
            await LoadTopUpIntents();
        if (idx == 3)
            await LoadDailyStats();
    }

    async Task LoadUsers()
    {
        usersLoading = true;
        users = await Api.GetAdminUsersAsync(userPage, userSearch);
        usersLoading = false;
    }

    async Task LoadTransactions()
    {
        txLoading = true;
        transactions = await Api.GetAdminTransactionsAsync(txPage);
        txLoading = false;
    }

    async Task LoadTopUpIntents()
    {
        topupLoading = true;
        var st = string.IsNullOrWhiteSpace(topupStatusFilter) ? null : topupStatusFilter.Trim();
        topupIntents = await Api.GetAdminTopUpIntentsAsync(st, 1);
        topupLoading = false;
    }

    async Task ConfirmTopUp(int id)
    {
        topupActionMsg = null;
        topupActionErr = false;
        var (ok, err) = await Api.AdminConfirmTopUpIntentAsync(id);
        topupActionErr = !ok;
        topupActionMsg = ok ? "Đã ghi có ví (thủ công)." : err;
        if (ok)
            await LoadTopUpIntents();
    }

    async Task ImportBankLine()
    {
        importMsg = null;
        topupActionMsg = null;
        if (string.IsNullOrWhiteSpace(importMemo))
        {
            importMsg = "Nhập memo.";
            return;
        }

        if (!decimal.TryParse(importAmount, out var amt))
        {
            importMsg = "Số tiền không hợp lệ.";
            return;
        }

        if (!DateTime.TryParse(importDateStr, out var bd))
        {
            importMsg = "Ngày không hợp lệ (yyyy-MM-dd).";
            return;
        }

        importBusy = true;
        var bookingUtc = DateTime.SpecifyKind(bd.Date, DateTimeKind.Utc);
        var (ok, n, err) = await Api.ImportBankStatementLineAsync(bookingUtc, amt, importMemo.Trim());
        importBusy = false;
        if (ok)
        {
            importMsg = $"Đã import {n} dòng và chạy đối soát.";
            await LoadTopUpIntents();
        }
        else importMsg = err;
    }

    async Task LoadDailyStats()
    {
        statsLoading = true;
        statsJobMsg = null;
        dailyStats = await Api.GetAdminDailyStatsAsync(DateTime.UtcNow.AddDays(-60), DateTime.UtcNow.Date);
        statsLoading = false;
    }

    async Task RebuildYesterdayStats()
    {
        var (ok, err) = await Api.AdminRebuildDailyStatsAsync();
        statsJobMsg = ok ? "Đã rebuild snapshot hôm qua (UTC)." : err;
        await LoadDailyStats();
    }

    async Task OnSearchDebounced(string val)
    {
        userSearch = val;
        userPage = 1;
        await LoadUsers();
    }

    async Task ToggleUser(int id)
    {
        var (ok, updated, _) = await Api.ToggleUserAsync(id);
        if (ok && updated is not null)
        {
            var idx = users.FindIndex(u => u.Id == id);
            if (idx >= 0) users[idx] = updated;
        }
        stats = await Api.GetAdminStatsAsync();
    }

    void OpenEdit(AdminUserResponse u)
    {
        editUser = u; editFullName = u.FullName; editEmail = u.Email;
        editPhone = u.Phone; editBalance = u.Balance;
        editJapanBank = u.JapanBankName ?? "";
        editJapanUrl = u.JapanBankTopUpUrl ?? "";
        editError = "";
    }
    void CloseEdit() { editUser = null; editError = ""; }

    async Task SaveEdit()
    {
        if (string.IsNullOrWhiteSpace(editFullName) || string.IsNullOrWhiteSpace(editEmail))
        { editError = "Họ tên và email không được để trống."; return; }

        editSaving = true;
        var (ok, updated, err) = await Api.AdminUpdateUserAsync(editUser!.Id, editFullName, editEmail, editPhone, editBalance,
            string.IsNullOrWhiteSpace(editJapanBank) ? null : editJapanBank.Trim(),
            string.IsNullOrWhiteSpace(editJapanUrl) ? null : editJapanUrl.Trim());
        editSaving = false;

        if (ok && updated is not null)
        {
            var idx = users.FindIndex(u => u.Id == updated.Id);
            if (idx >= 0) users[idx] = updated;
            CloseEdit();
        }
        else editError = err;
    }

    void ConfirmDeleteUser(AdminUserResponse u) { deleteUser = u; deleteError = ""; }
    void CloseDelete() { deleteUser = null; deleteError = ""; }

    async Task DoDeleteUser()
    {
        deleteSaving = true;
        var (ok, err) = await Api.AdminDeleteUserAsync(deleteUser!.Id);
        deleteSaving = false;
        if (ok) { users.RemoveAll(u => u.Id == deleteUser!.Id); stats = await Api.GetAdminStatsAsync(); CloseDelete(); }
        else deleteError = err;
    }

    async Task PrevUserPage() { if (userPage > 1) { userPage--; await LoadUsers(); } }
    async Task NextUserPage() { userPage++; await LoadUsers(); }
    async Task PrevTxPage() { if (txPage > 1) { txPage--; await LoadTransactions(); } }
    async Task NextTxPage() { txPage++; await LoadTransactions(); }

    async Task Logout()
    {
        await Api.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "A";
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}".ToUpper() : name[..Math.Min(2, name.Length)].ToUpper();
    }

    static string FormatVnd(decimal amount) =>
        amount >= 1_000_000 ? $"{amount / 1_000_000:0.##}M ₫" : $"{amount:N0} ₫";

    static string FormatJpy(decimal amount) => $"¥{amount:N0}";
}
