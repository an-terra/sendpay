@page "/transfer"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-dash-page">
    <DashNav Active="transfer" />
    <div class="sp-dash-content">

    @if (step == "form")
    {
        <div class="sp-page-header">
            <a href="/dashboard" class="sp-back-circle"><i class="fa-solid fa-arrow-left"></i></a>
            <div><h1 class="sp-page-title">@Lang.T("tr_title")</h1></div>
        </div>

        <div class="sp-transfer-grid">
            <!-- LEFT: amount + form -->
            <div>
                <div class="sp-side-card" style="margin-bottom:1.2rem;padding:20px 24px">
                    <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px">
                        @Lang.T("tr_amount_lbl")
                    </div>
                    <div style="display:flex;align-items:center;gap:12px">
                        <input type="number" class="sp-amount-input" @bind="amount" @bind:event="oninput"
                               min="1000" placeholder="0" style="flex:1;font-size:32px;font-weight:800;color:var(--navy);border:none;outline:none;background:transparent;width:100%" />
                        <div style="background:var(--gray-bg);border-radius:10px;padding:8px 14px;font-weight:700;font-size:14px;white-space:nowrap;border:1px solid var(--gray-border)">
                            🇯🇵 JPY
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="sp-alert sp-alert-error" style="margin-bottom:12px">
                        <i class="fa-solid fa-circle-exclamation"></i> @error
                    </div>
                }

                <div class="sp-side-card" style="padding:20px 24px">
                    <div class="sp-form-group">
                        <label>@Lang.T("tr_phone_lbl")</label>
                        <input class="sp-form-input sp-form-input-lg" type="tel"
                               placeholder="@Lang.T("tr_phone_ph")"
                               @bind="phone" @bind:event="oninput" @bind:after="OnReceiverBindAfter" />
                    </div>
                    <div class="sp-form-group">
                        <label>@Lang.T("recip_country")</label>
                        <select class="sp-form-input sp-form-input-lg" @bind="countryCode" @bind:after="OnCountryChanged">
                            <option value="VN">@Lang.T("recip_country_vn")</option>
                            <option value="LK">@Lang.T("recip_country_lk")</option>
                            <option value="NP">@Lang.T("recip_country_np")</option>
                            <option value="PH">@Lang.T("recip_country_ph")</option>
                            <option value="OTHER">@Lang.T("recip_country_other")</option>
                        </select>
                    </div>
                    @if (RecipientCatalogCountries.UsesCatalog(countryCode))
                    {
                        <div class="sp-form-group">
                            <label>@Lang.T("recip_bank_search")</label>
                            <input class="sp-form-input sp-form-input-lg" type="text" autocomplete="off"
                                   placeholder="@Lang.T("recip_bank_ph")"
                                   @bind="catalogBankSearch" @bind:event="oninput" @bind:after="OnReceiverBindAfter" />
                            @if (FilteredTransferCatalogBanks.Count > 0 && (string.IsNullOrEmpty(bankName) || !string.Equals(catalogBankSearch, bankName, StringComparison.Ordinal)))
                            {
                                <div style="max-height:180px;overflow-y:auto;border:1px solid var(--gray-border);border-radius:10px;margin-top:8px">
                                    @foreach (var b in FilteredTransferCatalogBanks.Take(25))
                                    {
                                        <button type="button" class="sp-btn-gray" style="width:100%;text-align:left;padding:10px 12px;border-radius:0;border:none;border-bottom:1px solid var(--gray-border);font-size:13px;background:white"
                                                @onclick="@(() => PickTransferCatalogBank(b))">
                                            @b.Name
                                        </button>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(bankName) && RecipientCatalogCountries.UsesCatalog(countryCode))
                            {
                                <div style="font-size:12px;color:var(--green);margin-top:6px">@Lang.T("recip_bank_picked"): @bankName</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="sp-form-group">
                            <label>@Lang.T("tr_bank_lbl")</label>
                            <input class="sp-form-input sp-form-input-lg" type="text"
                                   placeholder="@Lang.T("tr_bank_ph")"
                                   @bind="bankName" @bind:event="oninput" @bind:after="OnReceiverBindAfter" />
                        </div>
                    }
                    <div class="sp-form-group">
                        <label>@Lang.T("tr_account_lbl")</label>
                        <input class="sp-form-input sp-form-input-lg" type="text" inputmode="numeric"
                               placeholder="@Lang.T("tr_account_ph")"
                               @bind="bankAccount" @bind:event="oninput" @bind:after="OnReceiverBindAfter" />
                    </div>
                    <div class="sp-form-group">
                        <label>@Lang.T("tr_holder_lbl")</label>
                        <input class="sp-form-input sp-form-input-lg" type="text"
                               placeholder="@Lang.T("tr_holder_ph")"
                               @bind="bankHolder" @bind:event="oninput" @bind:after="OnReceiverBindAfter" />
                    </div>
                    @if (recipientSuggestions.Count > 0)
                    {
                        <div class="sp-form-group" style="margin-top:-4px">
                            <div style="font-size:12px;color:var(--text-muted);font-weight:600;margin-bottom:8px">@Lang.T("tr_addrbook_suggest")</div>
                            <div style="display:flex;flex-direction:column;gap:6px">
                                @foreach (var r in recipientSuggestions)
                                {
                                    <button type="button" class="sp-btn-gray" style="text-align:left;padding:10px 12px;font-size:13px;border-radius:10px"
                                            @onclick="@(() => ApplyRecipientFromBookAsync(r))">
                                        <strong>@r.Name</strong>
                                        <span style="display:block;color:var(--text-sub);font-size:12px;margin-top:2px">@FormatRecipientHintLine(r)</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    <div class="sp-form-group">
                        @if (receiverLookupLoading)
                        {
                            <div style="font-size:12px;color:var(--text-muted);margin-top:4px">@Lang.T("tr_receiver_checking")</div>
                        }
                        else if (receiverIsSelf)
                        {
                            <div class="sp-alert sp-alert-error" style="margin-top:4px;font-size:13px;padding:10px 12px">@Lang.T("tr_receiver_self")</div>
                        }
                        else if (!string.IsNullOrEmpty(receiverResolvedName))
                        {
                            <div style="font-size:14px;color:var(--green);font-weight:600;margin-top:4px">@Lang.T("tr_receiver_lookup_ok")@receiverResolvedName</div>
                            @if (!string.IsNullOrEmpty(receiverBankDisplay))
                            {
                                <div style="font-size:12px;color:var(--text-sub);margin-top:4px">@receiverBankDisplay</div>
                            }
                        }
                        else if (receiverShowNotFound)
                        {
                            <div style="font-size:13px;color:#b45309;margin-top:4px">@Lang.T("tr_receiver_not_found")</div>
                        }
                    </div>
                    <div class="sp-form-group">
                        <label>@Lang.T("tr_note_lbl")</label>
                        <input class="sp-form-input sp-form-input-lg" type="text"
                               placeholder="@Lang.T("tr_note_ph")" @bind="note" />
                    </div>
                    <div class="sp-form-group" style="margin-bottom:0">
                        <label>@Lang.T("tr_purpose_lbl")</label>
                        <select class="sp-form-input sp-form-input-lg" @bind="purpose">
                            <option value="tr_purpose_1">@Lang.T("tr_purpose_1")</option>
                            <option value="tr_purpose_2">@Lang.T("tr_purpose_2")</option>
                            <option value="tr_purpose_3">@Lang.T("tr_purpose_3")</option>
                            <option value="tr_purpose_4">@Lang.T("tr_purpose_4")</option>
                            <option value="tr_purpose_5">@Lang.T("tr_purpose_5")</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- RIGHT: fee summary + CTA -->
            <div class="sp-side-card">
                @if (balance > 0)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;background:var(--navy);border-radius:10px;padding:12px 16px">
                        <span style="color:rgba(255,255,255,.7);font-size:12px"><i class="fa-solid fa-wallet" style="margin-right:6px"></i>@Lang.T("dash_bal_label")</span>
                        <strong style="color:white;font-size:16px">¥@balance.ToString("N0")</strong>
                    </div>
                }

                @if (LocalRate > 0)
                {
                    <div style="background:var(--gray-bg);border-radius:10px;padding:10px 14px;margin-bottom:16px;font-size:13px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px">
                        <span style="color:var(--text-sub)">@Lang.T("rates_base") JPY</span>
                        <strong style="color:var(--navy)">1 JPY = @LocalRate.ToString("N2") @LocalCurrency</strong>
                        @if (amount > 0)
                        {
                            <span style="color:var(--green);font-weight:600">≈ @((amount * LocalRate).ToString("N0")) @LocalCurrency</span>
                        }
                    </div>
                }

                <div style="font-size:13px;font-weight:700;color:var(--navy);margin-bottom:16px;display:flex;align-items:center;gap:8px">
                    <i class="fa-solid fa-receipt" style="color:var(--red)"></i>
                    @Lang.T("tr_confirm_title")
                </div>

                <div class="sp-detail-row">
                    <span class="dlabel">@Lang.T("tr_send_amt")</span>
                    <span class="dval">@(amount > 0 ? $"¥{amount:N0}" : "---")</span>
                </div>
                <div class="sp-detail-row">
                    <span class="dlabel">@Lang.T("tr_fee_lbl")</span>
                    <span class="dval" style="color:var(--green)">@(amount > 0 ? $"¥{Fee:N0}" : "---")</span>
                </div>
                <div class="sp-detail-row" style="border-bottom:none;margin-top:8px;padding-top:14px;border-top:2px solid var(--gray-border)">
                    <span class="dlabel" style="font-weight:700;color:var(--navy)">@Lang.T("tr_total")</span>
                    <span class="dval" style="color:var(--red);font-size:20px;font-weight:800">
                        @(amount > 0 ? $"¥{(amount + Fee):N0}" : "---")
                    </span>
                </div>

                <div class="sp-detail-row" style="border-bottom:none;margin-top:8px;padding-top:12px;border-top:1px dashed var(--gray-border)">
                    <span class="dlabel">@Lang.T("tr_receiver")</span>
                    <span class="dval" style="text-align:right;font-weight:700">
                        @(string.IsNullOrEmpty(receiverResolvedName) ? "—" : receiverResolvedName)
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(TransferBankSummaryLine))
                {
                    <div class="sp-detail-row" style="border-bottom:none;padding-top:4px">
                        <span class="dlabel">@Lang.T("tr_bank_lbl") / @Lang.T("tr_account_lbl")</span>
                        <span class="dval" style="text-align:right;font-size:13px">@TransferBankSummaryLine</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(bankHolder))
                {
                    <div class="sp-detail-row" style="border-bottom:none;padding-top:4px">
                        <span class="dlabel">@Lang.T("tr_holder_lbl")</span>
                        <span class="dval" style="text-align:right;font-size:13px">@bankHolder.Trim()</span>
                    </div>
                }

                <button class="sp-cta-full" style="margin-top:20px" @onclick="GoToConfirm">
                    @Lang.T("tr_continue") <i class="fa-solid fa-arrow-right"></i>
                </button>
                <div style="text-align:center;margin-top:10px;font-size:11px;color:var(--text-muted)">
                    <i class="fa-solid fa-lock"></i> @Lang.T("tr_security")
                </div>
            </div>
        </div>
    }

    @if (step == "confirm")
    {
        <div class="sp-page-header">
            <button class="sp-back-circle" @onclick='() => step = "form"'>
                <i class="fa-solid fa-arrow-left"></i>
            </button>
            <div><h1 class="sp-page-title">@Lang.T("tr_confirm_title")</h1></div>
        </div>

        <div class="sp-transfer-grid">

            <!-- LEFT: detail rows -->
            <div class="sp-detail-card">
                <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_receiver")</span><span class="dval">@ConfirmReceiverLine</span></div>
                @if (!string.IsNullOrEmpty(TransferBankSummaryLine))
                {
                    <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_bank_lbl") / @Lang.T("tr_account_lbl")</span><span class="dval">@TransferBankSummaryLine</span></div>
                }
                <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_send_amt")</span><span class="dval">¥@amount.ToString("N0")</span></div>
                <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_fee")</span><span class="dval" style="color:var(--green)">¥@Fee.ToString("N0")</span></div>
                <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_total")</span><span class="dval" style="color:var(--red);font-size:15px">¥@((amount + Fee).ToString("N0"))</span></div>
                <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_note")</span><span class="dval">@(string.IsNullOrEmpty(note) ? "—" : note)</span></div>
                <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_type")</span><span class="dval"><span class="badge-fast">⚡ @Lang.T("instant_badge")</span></span></div>
                <div class="sp-detail-row" style="border-bottom:none"><span class="dlabel">@Lang.T("tr_purpose")</span><span class="dval">@Lang.T(purpose)</span></div>
            </div>

            <!-- RIGHT: confirm card -->
            <div class="sp-side-card">
                <div class="sp-confirm-box" style="border-radius:14px;margin-bottom:16px">
                    <div class="clabel">@Lang.T("tr_send_amt")</div>
                    <div class="camount">¥@amount.ToString("N0")</div>
                    <div class="csub">@Lang.T("tr_fee"): ¥@Fee.ToString("N0")</div>
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="sp-alert-error" style="margin-bottom:12px">
                        <i class="fa-solid fa-circle-exclamation"></i> @error
                    </div>
                }

                <button class="sp-cta-full" @onclick="HandleTransfer" disabled="@loading">
                    @if (loading)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span> @Lang.T("tr_processing")</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check"></i>
                        <span> @Lang.T("tr_confirm_btn")</span>
                    }
                </button>
                <div style="text-align:center;margin-top:12px;font-size:11px;color:var(--text-muted)">
                    <i class="fa-solid fa-lock"></i> @Lang.T("tr_security")
                </div>
            </div>

        </div>
    }

    @if (step == "success")
    {
        <div style="max-width:520px;margin:3rem auto;text-align:center;padding:0 1rem">
            <div class="sp-success-anim"><i class="fa-solid fa-check"></i></div>
            <h2 style="font-size:26px;font-weight:800;color:var(--navy);margin-bottom:8px">@Lang.T("tr_success_title")</h2>
            <p style="font-size:15px;color:var(--text-sub);margin-bottom:24px">@Lang.T("tr_success_sub")</p>
            <div class="sp-txid-badge">@Lang.T("tr_txid_label"): SP-@DateTime.Now.ToString("yyyyMMdd")-@(successData?.Id.ToString() ?? "000")</div>

            <div class="sp-detail-card" style="text-align:left;margin-bottom:20px">
                <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_receiver")</span><span class="dval">@(successData?.ReceiverName ?? ConfirmReceiverLine)</span></div>
                @if (!string.IsNullOrWhiteSpace(successData?.ReceiverBankName) || !string.IsNullOrWhiteSpace(successData?.ReceiverAccountNumber))
                {
                    <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_bank_lbl") / @Lang.T("tr_account_lbl")</span><span class="dval">@FormatBankAcctLine(successData?.ReceiverBankName, successData?.ReceiverAccountNumber)</span></div>
                }
                else if (!string.IsNullOrEmpty(TransferBankSummaryLine))
                {
                    <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_bank_lbl") / @Lang.T("tr_account_lbl")</span><span class="dval">@TransferBankSummaryLine</span></div>
                }
                <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_send_amt")</span><span class="dval">¥@(successData?.Amount.ToString("N0") ?? amount.ToString("N0"))</span></div>
                <div class="sp-detail-row"><span class="dlabel">@Lang.T("tr_time")</span><span class="dval">@DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss")</span></div>
                <div class="sp-detail-row" style="border-bottom:none"><span class="dlabel">@Lang.T("tr_status")</span><span class="dval"><span class="badge-fast">@Lang.T("tr_success_status")</span></span></div>
            </div>

            <div class="sp-success-actions">
                <a href="/dashboard" class="sp-btn-gray"><i class="fa-solid fa-house"></i> @Lang.T("tr_home")</a>
                <button class="sp-btn-gray" style="flex:1"><i class="fa-solid fa-download"></i> @Lang.T("tr_receipt")</button>
            </div>
            <button class="sp-btn-navy" @onclick="Reset" style="width:100%;margin-top:10px">
                <i class="fa-solid fa-plus"></i> @Lang.T("tr_new")
            </button>
        </div>
    }

    </div>
</div>

@code {
    string step = "form";
    string phone = "", bankAccount = "", bankName = "", bankHolder = "", countryCode = "VN", catalogBankSearch = "";
    string note = "", error = "", purpose = "tr_purpose_1";
    decimal amount;
    List<CurrencyRate> allRates = [];
    readonly Dictionary<string, List<CatalogBankOption>> _transferBankCache = new(StringComparer.OrdinalIgnoreCase);
    List<CatalogBankOption> transferCatalogBanks = [];
    decimal balance;
    bool loading;
    TransactionResponse? successData;
    string receiverResolvedName = "";
    string receiverBankDisplay = "";
    string? lookupResolvedPhone;
    bool receiverIsSelf;
    bool receiverShowNotFound;
    bool receiverLookupLoading;
    CancellationTokenSource? _phoneLookupCts;

    List<RecipientResponse> allRecipients = [];
    List<RecipientResponse> recipientSuggestions = [];

    List<CatalogBankOption> FilteredTransferCatalogBanks
    {
        get
        {
            if (transferCatalogBanks.Count == 0) return [];
            var q = (catalogBankSearch ?? "").Trim();
            if (string.IsNullOrEmpty(q)) return transferCatalogBanks;
            return [.. transferCatalogBanks.Where(b => b.Name.Contains(q, StringComparison.OrdinalIgnoreCase))];
        }
    }

    static readonly Dictionary<string, string> _langCurrency = new()
    {
        ["vi"] = "VND", ["ko"] = "KRW", ["zh"] = "CNY", ["en"] = "USD", ["ja"] = "VND",
    };
    string LocalCurrency => _langCurrency.GetValueOrDefault(Lang.Current, "VND");
    decimal LocalRate => allRates.FirstOrDefault(r => r.Code == LocalCurrency)?.Rate ?? 0;
    decimal Fee => amount <= 10_000 ? 200 : amount <= 50_000 ? 400 : 800;

    string EffectivePhone => string.IsNullOrWhiteSpace(lookupResolvedPhone) ? phone : lookupResolvedPhone!;

    string ConfirmReceiverLine =>
        string.IsNullOrEmpty(receiverResolvedName)
            ? EffectivePhone
            : $"{receiverResolvedName} · {EffectivePhone}";

    string TransferBankSummaryLine
    {
        get
        {
            if (string.IsNullOrWhiteSpace(bankName) && string.IsNullOrWhiteSpace(bankAccount)) return "";
            var bn = string.IsNullOrWhiteSpace(bankName) ? "—" : bankName.Trim();
            var key = AccountKey(bankAccount);
            var tail = string.IsNullOrEmpty(key) ? "—" : (key.Length <= 4 ? key : key[^4..]);
            return $"{bn} · ****{tail}";
        }
    }

    static string DigitsOnly(string? s) =>
        string.IsNullOrEmpty(s) ? "" : new string(s.Where(char.IsDigit).ToArray());

    static string AccountKey(string? s) =>
        string.IsNullOrEmpty(s) ? "" : string.Concat(s.Where(char.IsLetterOrDigit)).ToUpperInvariant();

    static string FormatBankAcctLine(string? bankName, string? accountNumber)
    {
        var bn = string.IsNullOrWhiteSpace(bankName) ? "—" : bankName.Trim();
        var key = AccountKey(accountNumber);
        var tail = string.IsNullOrEmpty(key) ? "—" : (key.Length <= 4 ? key : key[^4..]);
        return $"{bn} · ****{tail}";
    }

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var token = await LocalStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token)) Nav.NavigateTo("/login");
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);

        try
        {
            var walletTask = Api.GetWalletAsync();
            var ratesTask  = Api.GetRatesAsync();
            try { await Task.WhenAll(walletTask, ratesTask); } catch { }
            balance  = walletTask.IsCompletedSuccessfully ? walletTask.Result?.Balance ?? 0 : 0;
            allRates = ratesTask.IsCompletedSuccessfully ? ratesTask.Result?.Rates ?? [] : [];
        }
        catch { }

        try { allRecipients = await Api.GetRecipientsAsync(); }
        catch { allRecipients = []; }

        await ApplyTransferQueryAsync();
        await EnsureTransferCatalogLoadedAsync(countryCode);
    }

    async Task EnsureTransferCatalogLoadedAsync(string country)
    {
        if (!RecipientCatalogCountries.UsesCatalog(country))
        {
            transferCatalogBanks = [];
            return;
        }

        if (_transferBankCache.TryGetValue(country, out var hit))
        {
            transferCatalogBanks = hit;
            return;
        }

        try
        {
            var list = await Api.GetCatalogBanksAsync(country);
            _transferBankCache[country] = list;
            transferCatalogBanks = list;
        }
        catch
        {
            transferCatalogBanks = [];
        }
    }

    async Task ApplyTransferQueryAsync()
    {
        var uri = new Uri(Nav.Uri);
        var q = ParseQueryString(uri.Query);
        if (q.TryGetValue("recipientId", out var ridStr) && int.TryParse(ridStr, out var rid))
        {
            try
            {
                var rec = await Api.GetRecipientByIdAsync(rid);
                if (rec != null)
                {
                    phone = rec.Phone ?? "";
                    bankAccount = rec.AccountNumber ?? "";
                    countryCode = RecipientCatalogCountries.FormCountryFromRecipient(rec);
                    bankName = rec.BankName ?? "";
                    catalogBankSearch = RecipientCatalogCountries.UsesCatalog(countryCode) ? bankName : "";
                    await EnsureTransferCatalogLoadedAsync(countryCode);
                    bankHolder = rec.AccountHolderName ?? "";
                    if (string.IsNullOrEmpty(note))
                        note = rec.Note ?? "";
                    await RefreshReceiverLookupAsync(forContinueButton: true);
                    return;
                }
            }
            catch { /* ignore */ }
        }

        if (q.TryGetValue("phone", out var ph) && !string.IsNullOrEmpty(ph))
            phone = ph;
    }

    static Dictionary<string, string> ParseQueryString(string query)
    {
        var d = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(query)) return d;
        var s = query.StartsWith('?') ? query[1..] : query;
        foreach (var part in s.Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var i = part.IndexOf('=');
            if (i < 0)
                d[Uri.UnescapeDataString(part)] = "";
            else
                d[Uri.UnescapeDataString(part[..i])] = Uri.UnescapeDataString(part[(i + 1)..]);
        }
        return d;
    }

    async Task OnReceiverBindAfter()
    {
        _phoneLookupCts?.Cancel();
        _phoneLookupCts?.Dispose();
        _phoneLookupCts = new CancellationTokenSource();
        var token = _phoneLookupCts.Token;
        try { await Task.Delay(400, token); }
        catch (TaskCanceledException) { return; }
        await RefreshReceiverLookupAsync();
        UpdateRecipientSuggestions();
        await InvokeAsync(StateHasChanged);
    }

    void UpdateRecipientSuggestions()
    {
        var terms = new List<string>();
        void addTerm(string? s)
        {
            s = (s ?? "").Trim();
            if (s.Length >= 2) terms.Add(s);
        }
        addTerm(phone);
        addTerm(bankName);
        addTerm(bankAccount);
        addTerm(bankHolder);
        if (terms.Count == 0)
        {
            recipientSuggestions = [];
            return;
        }

        bool Match(RecipientResponse r) =>
            terms.Exists(t =>
                (r.Name?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.Phone?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.BankName?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.AccountNumber?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.AccountHolderName?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false));

        recipientSuggestions = allRecipients.Where(Match).Take(8).ToList();
    }

    static string FormatRecipientHintLine(RecipientResponse r)
    {
        var ph = string.IsNullOrWhiteSpace(r.Phone) ? "—" : r.Phone!;
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(r.BankName)) parts.Add(r.BankName!);
        if (!string.IsNullOrWhiteSpace(r.AccountNumber)) parts.Add(r.AccountNumber!);
        if (parts.Count == 0) return ph;
        return $"{ph} · {string.Join(" · ", parts)}";
    }

    async Task PickTransferCatalogBank(CatalogBankOption b)
    {
        bankName = b.Name;
        catalogBankSearch = b.Name;
        await OnReceiverBindAfter();
    }

    async Task OnCountryChanged()
    {
        catalogBankSearch = "";
        bankName = "";
        await EnsureTransferCatalogLoadedAsync(countryCode);
        await OnReceiverBindAfter();
    }

    async Task ApplyRecipientFromBookAsync(RecipientResponse r)
    {
        phone = r.Phone ?? "";
        countryCode = RecipientCatalogCountries.FormCountryFromRecipient(r);
        bankName = r.BankName ?? "";
        catalogBankSearch = RecipientCatalogCountries.UsesCatalog(countryCode) ? bankName : "";
        bankAccount = r.AccountNumber ?? "";
        await EnsureTransferCatalogLoadedAsync(countryCode);
        bankHolder = r.AccountHolderName ?? "";
        if (string.IsNullOrEmpty(note))
            note = r.Note ?? "";
        recipientSuggestions = [];
        await RefreshReceiverLookupAsync(forContinueButton: true);
    }

    async Task RefreshReceiverLookupAsync(bool forContinueButton = false)
    {
        var phDigits = DigitsOnly(phone);
        var acctKey = AccountKey(bankAccount);
        if (!forContinueButton && phDigits.Length < 8 && acctKey.Length < 6)
        {
            receiverResolvedName = "";
            receiverBankDisplay = "";
            lookupResolvedPhone = null;
            receiverIsSelf = false;
            receiverShowNotFound = false;
            receiverLookupLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        receiverLookupLoading = true;
        if (!forContinueButton)
            receiverShowNotFound = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var res = await Api.LookupTransferCounterpartyAsync(
                string.IsNullOrWhiteSpace(phone) ? null : phone.Trim(),
                string.IsNullOrWhiteSpace(bankAccount) ? null : bankAccount.Trim(),
                string.IsNullOrWhiteSpace(bankName) ? null : bankName.Trim());

            if (res is null)
            {
                receiverResolvedName = "";
                receiverBankDisplay = "";
                lookupResolvedPhone = null;
                receiverIsSelf = false;
                receiverShowNotFound = !forContinueButton && (phDigits.Length >= 8 || acctKey.Length >= 6);
            }
            else
            {
                receiverIsSelf = res.IsSelf;
                receiverResolvedName = res.Found && !string.IsNullOrEmpty(res.FullName) ? res.FullName! : "";
                receiverBankDisplay = res.BankDisplay ?? "";
                lookupResolvedPhone = string.IsNullOrWhiteSpace(res.ResolvedPhone) ? null : res.ResolvedPhone;
                var canShowNotFound = !forContinueButton && (phDigits.Length >= 8 || acctKey.Length >= 6);
                receiverShowNotFound = canShowNotFound && !res.Found && !res.IsSelf;
            }
        }
        finally
        {
            receiverLookupLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task GoToConfirm()
    {
        error = "";
        if (amount < 1_000) { error = "Min ¥1,000"; return; }
        var phD = DigitsOnly(phone);
        var acK = AccountKey(bankAccount);
        if (phD.Length < 8 && acK.Length < 6)
        { error = Lang.T("tr_lookup_need_input"); return; }

        await RefreshReceiverLookupAsync(forContinueButton: true);

        if (receiverIsSelf) { error = Lang.T("tr_receiver_self"); return; }
        if (string.IsNullOrEmpty(receiverResolvedName)) { error = Lang.T("tr_receiver_not_found"); return; }

        var eff = EffectivePhone;
        if (DigitsOnly(eff).Length < 8)
        { error = Lang.T("tr_receiver_need_phone"); return; }

        if (RecipientCatalogCountries.UsesCatalog(countryCode))
        {
            if (string.IsNullOrWhiteSpace(bankName) ||
                !transferCatalogBanks.Exists(b => string.Equals(b.Name, bankName.Trim(), StringComparison.OrdinalIgnoreCase)))
            { error = Lang.T("recip_err_bank_catalog"); return; }
        }
        else if (string.IsNullOrWhiteSpace(bankName))
        { error = Lang.T("tr_bank_required"); return; }

        step = "confirm";
    }

    async Task HandleTransfer()
    {
        error = "";
        loading = true;
        var rb = string.IsNullOrWhiteSpace(bankName) ? null : bankName.Trim();
        var ra = string.IsNullOrWhiteSpace(bankAccount) ? null : bankAccount.Trim();
        var (ok, data, err) = await Api.TransferAsync(EffectivePhone.Trim(), amount, note, rb, ra);
        loading = false;
        if (ok) { successData = data; step = "success"; }
        else { error = err; }
    }

    void Reset()
    {
        step = "form"; phone = bankAccount = bankName = bankHolder = catalogBankSearch = note = error = "";
        countryCode = "VN";
        _ = EnsureTransferCatalogLoadedAsync("VN");
        amount = 0; successData = null;
        recipientSuggestions = [];
        purpose = "tr_purpose_1";
        receiverResolvedName = "";
        receiverBankDisplay = "";
        lookupResolvedPhone = null;
        receiverIsSelf = false;
        receiverShowNotFound = false;
        receiverLookupLoading = false;
    }

    public void Dispose()
    {
        Lang.OnChanged -= StateHasChanged;
        _phoneLookupCts?.Cancel();
        _phoneLookupCts?.Dispose();
    }
}
