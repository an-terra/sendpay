@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@inject UserStateService UserState
@implements IDisposable

<nav class="sp-dash-nav">
    <a class="sp-dash-logo" href="/dashboard">
        <img src="/images/logo.png" alt="SendPay" class="sp-logo-img sp-logo-img--nav" />
    </a>
    <div class="sp-dash-nav-links">
        <a href="/dashboard" class="sp-dash-nav-link @(Active=="dashboard"?"active":"")">
            <i class="fa-solid fa-house-chimney"></i> @Lang.T("dash_home")
        </a>
        <span class="sp-nav-sep"></span>
        <a href="/transfer" class="sp-dash-nav-link @(Active=="transfer"?"active":"")">
            @Lang.T("dash_transfer")
        </a>
        <span class="sp-nav-sep"></span>
        <a href="/topup" class="sp-dash-nav-link @(Active=="topup"?"active":"")">
            @Lang.T("dash_topup")
        </a>
        <span class="sp-nav-sep"></span>
        <a href="/history" class="sp-dash-nav-link @(Active=="history"?"active":"")">
            @Lang.T("dash_history")
        </a>
    </div>
    <div class="sp-dash-nav-right">
        <LangSelector Dark="true" />
        <div class="sp-dash-user">
            <div class="sp-dash-avatar">
                @if (!string.IsNullOrEmpty(AvatarSrc))
                {
                    <img src="@AvatarSrc" class="sp-nav-avatar-img" alt="avatar" />
                }
                else
                {
                    @GetInitials(fullName)
                }
            </div>
            <span>@fullName</span>
        </div>
        <button class="sp-dash-logout" @onclick="Logout">
            <i class="fa-solid fa-right-from-bracket"></i> <span class="sp-dash-logout-txt">@Lang.T("dash_logout")</span>
        </button>
    </div>
</nav>

@code {
    [Parameter] public string Active { get; set; } = "";
    string fullName = "";
    string localAvatar = "";

    string AvatarSrc => !string.IsNullOrEmpty(UserState.AvatarData)
        ? UserState.AvatarData
        : localAvatar;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged    += StateHasChanged;
        UserState.OnChanged += OnAvatarUpdated;
        fullName    = await LocalStorage.GetItemAsync<string>("fullName") ?? "";
        localAvatar = await LocalStorage.GetItemAsync<string>("sp_avatar") ?? "";
    }

    void OnAvatarUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Lang.OnChanged      -= StateHasChanged;
        UserState.OnChanged -= OnAvatarUpdated;
    }

    async Task Logout()
    {
        await LocalStorage.RemoveItemAsync("token");
        await LocalStorage.RemoveItemAsync("fullName");
        await LocalStorage.RemoveItemAsync("isAdmin");
        Nav.NavigateTo("/login");
    }

    static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name[..Math.Min(2, name.Length)].ToUpper();
    }
}
