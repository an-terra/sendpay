@page "/history"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-dash-page">
    <DashNav Active="history" />
    <div class="sp-dash-content">

        <div class="sp-page-header">
            <a href="/dashboard" class="sp-back-circle"><i class="fa-solid fa-arrow-left"></i></a>
            <div>
                <h1 class="sp-page-title">@Lang.T("hist_title")</h1>
            </div>
        </div>

        @if (loading)
        {
            <div class="sp-loading-text">
                <i class="fa-solid fa-spinner fa-spin" style="font-size:28px;margin-bottom:12px;display:block"></i>
                @Lang.T("hist_loading")
            </div>
        }
        else if (transactions.Count == 0)
        {
            <div class="sp-dash-tx-card">
                <div style="text-align:center;padding:64px;color:var(--text-muted)">
                    <i class="fa-solid fa-inbox" style="font-size:42px;margin-bottom:14px;display:block;color:var(--gray-border)"></i>
                    @Lang.T("hist_empty")
                </div>
            </div>
        }
        else
        {
            <div class="sp-dash-tx-card">
                @foreach (var tx in transactions)
                {
                    bool isIncoming = tx.Type == 1 || (tx.Type == 0 && tx.SenderId != currentUserId);
                    string avatarColor = isIncoming ? "#0D7A4E" : "#3B5BDB";
                    string initials = tx.Type == 1 ? "+" : GetInitials(isIncoming ? tx.SenderName : tx.ReceiverName);
                    string label = tx.Type == 1
                        ? Lang.T("hist_topup")
                        : isIncoming ? $"{tx.SenderName} → Bạn" : $"Bạn → {tx.ReceiverName}";
                    <div class="sp-dash-tx-row">
                        <div class="sp-tx-avatar" style="background:@avatarColor;width:44px;height:44px;font-size:14px">@initials</div>
                        <div class="sp-tx-info">
                            <div class="sp-tx-name">@label</div>
                            @if (!string.IsNullOrEmpty(tx.Note) && tx.Type != 1)
                            {
                                <div class="sp-tx-meta" style="font-style:italic">@tx.Note</div>
                            }
                            <div class="sp-tx-meta">@tx.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                        </div>
                        <div class="sp-tx-amt-col">
                            <div class="sp-tx-amt @(isIncoming ? "in" : "out")">
                                @(isIncoming ? "+" : "−")¥@tx.Amount.ToString("N0")
                            </div>
                            <div class="sp-tx-status">✓ @Lang.T("hist_success")</div>
                        </div>
                    </div>
                }
            </div>

            <div class="sp-dash-section-row" style="margin-top:1rem">
                <button class="sp-page-btn" @onclick="PrevPage" disabled="@(page <= 1)">
                    <i class="fa-solid fa-chevron-left"></i> @Lang.T("hist_prev")
                </button>
                <span class="sp-page-label">@Lang.T("hist_page") @(page)</span>
                <button class="sp-page-btn" @onclick="NextPage" disabled="@(transactions.Count < 10)">
                    @Lang.T("hist_next") <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        }

    </div>
</div>

@code {
    List<TransactionResponse> transactions = [];
    bool loading = true;
    int page = 1;
    int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var token = await LocalStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token)) { Nav.NavigateTo("/login"); return; }
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);
        currentUserId = await LocalStorage.GetItemAsync<int>("userId");
        await LoadPage();
    }

    async Task LoadPage()
    {
        loading = true;
        transactions = await Api.GetHistoryAsync(page) ?? [];
        loading = false;
    }

    async Task PrevPage() { if (page > 1) { page--; await LoadPage(); } }
    async Task NextPage() { page++; await LoadPage(); }

    static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name[..Math.Min(2, name.Length)].ToUpper();
    }

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
