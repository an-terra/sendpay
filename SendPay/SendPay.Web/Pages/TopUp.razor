@page "/topup"
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

<div class="sp-dash-page">
    <DashNav Active="topup" />
    <div class="sp-dash-content">

        <div class="sp-page-header">
            <a href="/dashboard" class="sp-back-circle"><i class="fa-solid fa-arrow-left"></i></a>
            <div>
                <h1 class="sp-page-title">@Lang.T("topup_title")</h1>
                <p class="sp-page-sub"><i class="fa-solid fa-circle-check" style="color:var(--green)"></i> @Lang.T("topup_free")</p>
            </div>
        </div>

        <div class="sp-topup-grid">

            <!-- LEFT: amount display + quick amounts -->
            <div>
                <div class="sp-amount-display" style="margin-bottom:1.5rem">
                    <div class="sp-amount-label">@Lang.T("topup_amount_lbl")</div>
                    <div style="font-size:52px;font-weight:800;color:white;letter-spacing:-2px;text-align:center;padding:14px 0">
                        ¥@amount.ToString("N0")
                    </div>
                    <div class="sp-cur-pill">🇯🇵 JPY</div>
                </div>

                <div class="sp-dash-section-title">@Lang.T("topup_quick")</div>
                <div class="sp-topup-quick-grid">
                    @foreach (var amt in new[] { 5_000m, 10_000m, 30_000m, 50_000m, 100_000m, 200_000m })
                    {
                        <button class="sp-quick-amt-btn @(amount == amt ? "selected" : "")"
                                @onclick="() => amount = amt">
                            ¥@amt.ToString("N0")
                        </button>
                    }
                </div>
            </div>

            <!-- RIGHT: input + CTA -->
            <div class="sp-side-card">
                @if (balance > 0)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;background:var(--navy);border-radius:10px;padding:12px 16px">
                        <span style="color:rgba(255,255,255,.7);font-size:12px"><i class="fa-solid fa-wallet" style="margin-right:6px"></i>@Lang.T("dash_bal_label")</span>
                        <strong style="color:white;font-size:16px">¥@balance.ToString("N0")</strong>
                    </div>
                }
                <div class="sp-fee-info" style="margin-bottom:20px">
                    <i class="fa-solid fa-circle-info"></i>
                    @Lang.T("topup_free")
                </div>

                <div class="sp-form-field">
                    <label>@Lang.T("topup_custom_lbl")</label>
                    <input class="sp-form-input sp-form-input-lg" type="number" @bind="amount"
                           placeholder="@Lang.T("topup_custom_ph")" min="1000" />
                </div>

                @if (!string.IsNullOrEmpty(successMsg))
                {
                    <div class="sp-alert-success" style="margin-bottom:12px">
                        <i class="fa-solid fa-circle-check"></i> @successMsg
                    </div>
                }
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="sp-alert-error" style="margin-bottom:12px">
                        <i class="fa-solid fa-circle-exclamation"></i> @error
                    </div>
                }

                <button class="sp-cta-full" @onclick="HandleTopUp" disabled="@loading">
                    @if (loading)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span> @Lang.T("topup_loading")</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-plus"></i>
                        <span> @Lang.T("topup_btn") ¥@amount.ToString("N0")</span>
                    }
                </button>

                <div style="margin-top:16px;background:var(--gray-bg);border-radius:12px;padding:16px">
                    <div style="font-size:12px;font-weight:700;color:var(--navy);margin-bottom:8px">
                        <i class="fa-solid fa-circle-info" style="color:var(--red)"></i>
                        ご利用案内 / Hướng dẫn
                    </div>
                    <div style="font-size:12px;color:var(--text-sub);line-height:1.9">
                        • 最低入金額 / Số tiền tối thiểu: ¥1,000<br>
                        • 手数料無料 / Miễn phí nạp tiền<br>
                        • 即時反映 / Số dư cập nhật ngay lập tức
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    decimal amount = 10_000;
    decimal balance;
    string error = "", successMsg = "";
    bool loading;

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChanged += StateHasChanged;
        var token = await LocalStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token)) Nav.NavigateTo("/login");
        var saved = await LocalStorage.GetItemAsync<string>("sp_lang");
        if (!string.IsNullOrEmpty(saved)) Lang.Set(saved);
        var wallet = await Api.GetWalletAsync();
        balance = wallet?.Balance ?? 0;
    }

    async Task HandleTopUp()
    {
        error = successMsg = "";
        loading = true;
        var (ok, data, err) = await Api.TopUpAsync(amount);
        loading = false;

        if (ok && data != null)
        {
            balance = data.Balance;
            successMsg = $"+¥{amount:N0} → Số dư: ¥{data.Balance:N0}";
        }
        else error = err;
    }

    public void Dispose() => Lang.OnChanged -= StateHasChanged;
}
