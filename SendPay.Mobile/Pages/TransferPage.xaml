<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SendPay.Mobile.Pages.TransferPage"
             BackgroundColor="#f5f5f7" Title="Chuyển tiền">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label x:Name="MsgLabel" IsVisible="False" FontSize="14"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

            <Frame BackgroundColor="White" CornerRadius="16" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Số điện thoại người nhận (SendPay)" FontSize="13"
                               TextColor="#8b8b9b" FontAttributes="Bold"/>
                        <Entry x:Name="PhoneEntry" Placeholder="0901234567" Keyboard="Telephone"
                               TextChanged="OnReceiverFieldTextChanged"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Ngân hàng (tùy chọn)" FontSize="13" TextColor="#8b8b9b" FontAttributes="Bold"/>
                        <Entry x:Name="BankNameEntry" Placeholder="Vietcombank"
                               TextChanged="OnReceiverFieldTextChanged"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Số tài khoản" FontSize="13" TextColor="#8b8b9b" FontAttributes="Bold"/>
                        <Entry x:Name="AccountEntry" Placeholder="STK người nhận" Keyboard="Default"
                               TextChanged="OnReceiverFieldTextChanged"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Chủ tài khoản (tùy chọn)" FontSize="13" TextColor="#8b8b9b" FontAttributes="Bold"/>
                        <Entry x:Name="HolderEntry" Placeholder="VD: NGUYEN VAN A" Keyboard="Default"
                               TextChanged="OnReceiverFieldTextChanged"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="SWIFT / BIC" FontSize="13" TextColor="#8b8b9b" FontAttributes="Bold"/>
                        <Entry x:Name="SwiftEntry" Placeholder="VD: BIDVVNVX" Keyboard="Default"
                               TextChanged="OnReceiverFieldTextChanged"/>
                    </VerticalStackLayout>

                    <Border x:Name="SuggestBorder" IsVisible="False" Stroke="#e2e8f0" StrokeThickness="1"
                            BackgroundColor="#f8fafc" Padding="10" Margin="0,4,0,0">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Gợi ý từ danh bạ" FontSize="11" TextColor="#64748b"/>
                            <VerticalStackLayout x:Name="SuggestStack" Spacing="6"/>
                        </VerticalStackLayout>
                    </Border>

                    <Label x:Name="ReceiverHintLabel" FontSize="13" IsVisible="False" Margin="0,0,0,4"/>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Số tiền (VND)" FontSize="13" TextColor="#8b8b9b" FontAttributes="Bold"/>
                        <Entry x:Name="AmountEntry" Placeholder="100,000" Keyboard="Numeric"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nội dung" FontSize="13" TextColor="#8b8b9b" FontAttributes="Bold"/>
                        <Entry x:Name="NoteEntry" Placeholder="Trả tiền ăn, cà phê..."/>
                    </VerticalStackLayout>

                    <Button x:Name="SendOtpBtn" Text="1. Gửi mã OTP"
                            Clicked="OnSendOtpClicked" BackgroundColor="#334155"
                            TextColor="White" CornerRadius="12" HeightRequest="48" FontAttributes="Bold"/>
                    <Label x:Name="OtpHintLabel" Text="Dev: sau khi gửi, xem debugOtp trong log API hoặc Fiddler."
                           FontSize="11" TextColor="#64748b" IsVisible="False"/>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Mã OTP 6 số" FontSize="13" TextColor="#8b8b9b" FontAttributes="Bold"/>
                        <Entry x:Name="OtpEntry" Placeholder="123456" Keyboard="Numeric" MaxLength="6"/>
                    </VerticalStackLayout>

                    <Button x:Name="TransferBtn" Text="2. Xác nhận chuyển tiền"
                            Clicked="OnTransferClicked" BackgroundColor="#6c47ff"
                            TextColor="White" CornerRadius="12" HeightRequest="52"
                            FontAttributes="Bold" FontSize="16"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
