<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:SendPay.Mobile.Pages"
             x:Class="SendPay.Mobile.Pages.RecipientsPage"
             BackgroundColor="#f5f5f7" Title="Người nhận">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label x:Name="StatusLabel" IsVisible="False" FontSize="13" HorizontalTextAlignment="Center"/>

            <Frame BackgroundColor="White" CornerRadius="14" Padding="16" HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="FormTitleLabel" Text="Thêm người nhận" FontAttributes="Bold" FontSize="15"/>
                    <Entry x:Name="NameEntry" Placeholder="Họ tên"/>
                    <Entry x:Name="PhoneEntryForm" Placeholder="SĐT SendPay (tuỳ chọn)" Keyboard="Telephone"/>
                    <Label Text="Quốc gia nhận" FontSize="13" TextColor="#8b8b9b" FontAttributes="Bold"/>
                    <Picker x:Name="CountryPicker" Title="Chọn" SelectedIndexChanged="OnCountryPickerChanged"/>
                    <Label x:Name="BankFieldLabel" Text="Tìm ngân hàng (Việt Nam)" FontSize="13" TextColor="#8b8b9b" FontAttributes="Bold"/>
                    <Entry x:Name="BankEntry" Placeholder="Gõ tên ngân hàng..." Keyboard="Default" TextChanged="OnBankSearchTextChanged"/>
                    <Border x:Name="VnBankSuggestBorder" IsVisible="False" Stroke="#e2e8f0" StrokeThickness="1" Padding="6" BackgroundColor="#f8fafc">
                        <VerticalStackLayout x:Name="VnBankSuggestStack" Spacing="4"/>
                    </Border>
                    <Label x:Name="BankPickedLabel" FontSize="12" TextColor="#16a34a" IsVisible="False"/>
                    <Entry x:Name="AccountEntry" Placeholder="Số tài khoản (bắt buộc)" Keyboard="Default"/>
                    <Entry x:Name="HolderEntry" Placeholder="Chủ TK đúng sổ ngân hàng (bắt buộc)"/>
                    <Entry x:Name="NoteEntryForm" Placeholder="Ghi chú"/>
                    <Button x:Name="CancelEditBtn" Text="Hủy sửa" Clicked="OnCancelEditClicked" BackgroundColor="#f1f5f9"
                            TextColor="#334155" CornerRadius="10" HeightRequest="44" FontAttributes="Bold" IsVisible="False"/>
                    <Button x:Name="SaveRecipientBtn" Text="Thêm vào danh bạ" Clicked="OnSaveClicked" BackgroundColor="#334155"
                            TextColor="White" CornerRadius="10" HeightRequest="46" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Danh sách" FontAttributes="Bold" FontSize="16" Margin="0,4,0,0"/>
            <Border Stroke="#e5e5e5" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="0">
                <ListView x:Name="RecipientList" HasUnevenRows="True" SeparatorVisibility="None"
                          ItemsSource="{Binding Rows}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="pages:RecipientRow">
                            <ViewCell>
                                <Grid Padding="14,12" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15"/>
                                        <Label Text="{Binding Detail}" FontSize="12" TextColor="#64748b" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Button Text="Sửa" Padding="12,6" FontSize="12" BackgroundColor="#e0e7ff"
                                                TextColor="#3730a3" CornerRadius="8"
                                                Clicked="OnEditClicked" CommandParameter="{Binding Id}"/>
                                        <Button Text="Gửi" Padding="12,6" FontSize="12" BackgroundColor="#6c47ff"
                                                TextColor="White" CornerRadius="8"
                                                Clicked="OnSendClicked" CommandParameter="{Binding Id}"/>
                                        <Button Text="Xóa" Padding="12,6" FontSize="12" BackgroundColor="#fee2e2"
                                                TextColor="#b91c1c" CornerRadius="8"
                                                Clicked="OnDeleteClicked" CommandParameter="{Binding Id}"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
