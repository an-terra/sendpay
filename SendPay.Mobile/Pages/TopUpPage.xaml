<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SendPay.Mobile.Pages.TopUpPage"
             BackgroundColor="#f5f5f7" Title="Nạp tiền">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label x:Name="MsgLabel" IsVisible="False" FontSize="14"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

            <Frame BackgroundColor="White" CornerRadius="16" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Ngân hàng nạp tại Nhật (bạn tự cấu hình)" FontSize="13"
                           TextColor="#334155" FontAttributes="Bold"/>
                    <Label x:Name="JapanBankNameLabel" FontSize="15" FontAttributes="Bold"
                           TextColor="#0f172a" IsVisible="False"/>
                    <Button x:Name="OpenJapanBankBtn" Text="Mở trang nạp / chuyển khoản ngân hàng"
                            Clicked="OnOpenJapanBankClicked" BackgroundColor="#0284c7"
                            TextColor="White" CornerRadius="12" HeightRequest="48"
                            FontAttributes="Bold" IsVisible="False"/>
                    <Label x:Name="JapanBankNoneLabel" Text="Chưa cấu hình ngân hàng. Vào trang chủ → “Ngân hàng nạp (Nhật)” để thêm tên và URL trang nạp."
                           FontSize="12" TextColor="#64748b" IsVisible="False" LineBreakMode="WordWrap"/>
                    <Button x:Name="GoBankSettingsBtn" Text="Mở cài đặt ngân hàng"
                            Clicked="OnGoBankSettingsClicked" BackgroundColor="#e0f2fe"
                            TextColor="#0369a1" CornerRadius="12" HeightRequest="44"
                            FontAttributes="Bold" IsVisible="False"/>

                    <Label Text="Có thể nạp tức thì (instant) hoặc tạo lệnh chờ chuyển khoản khi bật chế độ đối soát."
                           FontSize="12" TextColor="#64748b" LineBreakMode="WordWrap"/>

                    <Label x:Name="RefHintLabel" FontSize="13" TextColor="#0f172a" FontAttributes="Bold"
                           LineBreakMode="WordWrap" IsVisible="False"/>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Số tiền nạp (JPY)" FontSize="13" TextColor="#8b8b9b" FontAttributes="Bold"/>
                        <Entry x:Name="AmountEntry" Placeholder="10000" Keyboard="Numeric"/>
                    </VerticalStackLayout>

                    <Button x:Name="TopUpBtn" Text="Xác nhận nạp ví"
                            Clicked="OnTopUpClicked" BackgroundColor="#059669"
                            TextColor="White" CornerRadius="12" HeightRequest="52"
                            FontAttributes="Bold" FontSize="16"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
