<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SendPay.Mobile.Pages"
             x:Class="SendPay.Mobile.Pages.HistoryPage"
             BackgroundColor="#f5f5f7" Title="Lịch sử giao dịch">
    <RefreshView x:Name="Refresher" Refreshing="OnRefreshing" RefreshColor="#6c47ff">
        <CollectionView x:Name="TxList" Margin="16,8">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:TransactionItem">
                    <Frame BackgroundColor="White" CornerRadius="12" Margin="0,4" Padding="14" HasShadow="True">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Text="{Binding Icon}" FontSize="26" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14"/>
                                <Label Text="{Binding Note}" FontSize="12" TextColor="#6b7280"
                                       IsVisible="{Binding HasNote}"/>
                                <Label Text="{Binding BankLine}" FontSize="11" TextColor="#64748b"
                                       IsVisible="{Binding HasBank}" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Date}" FontSize="11" TextColor="#8b8b9b"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2" HorizontalOptions="End">
                                <Label Text="{Binding AmountText}" TextColor="{Binding AmountColor}"
                                       FontAttributes="Bold" FontSize="14" HorizontalOptions="End"/>
                                <Label Text="✓ Thành công" TextColor="#22c55e" FontSize="10" HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
